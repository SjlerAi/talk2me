<%
const scopeSuffix = returnQuery ? `?${returnQuery}` : '';
const panelJoin = returnQuery ? '&' : '?';
const managementUrl = `${basePath}/backoffice/monthly-import-management${scopeSuffix}${panelMode && !returnQuery.includes('panel=1') ? panelJoin+'panel=1' : ''}`;
const groups = [
  ['Successfully applied', result.applied, 'completed'],
  ['Already completed / skipped', result.skipped, 'completed'],
  ['Moved to exceptions', result.exceptions, 'exception'],
  ['Failed', result.failed, 'failed']
];
%>
<main class="mim-shell mim-bulk-page">
  <header class="mim-hero"><div><span class="eyebrow">Bulk Monthly Import</span><h1>Bulk processing results</h1><p>Safe rows were committed in bounded transactions. Exceptions remain unchanged for individual review.</p></div><nav><a class="btn" href="<%= managementUrl %>">Back to filtered results</a></nav></header>
  <section class="mim-summary" aria-label="Bulk execution totals">
    <article class="mim-summary-card completed"><span>Selected</span><strong><%= result.counts.selected %></strong></article><article class="mim-summary-card completed"><span>Applied</span><strong><%= result.counts.applied %></strong></article><article class="mim-summary-card"><span>Skipped</span><strong><%= result.counts.skipped %></strong></article><article class="mim-summary-card conflict"><span>Exceptions</span><strong><%= result.counts.exception %></strong></article><article class="mim-summary-card failed"><span>Failed</span><strong><%= result.counts.failed %></strong></article>
  </section>
  <nav class="mim-bulk-result-links"><a class="btn primary" href="<%= managementUrl %>">Open filtered management results</a><a class="btn" href="<%= basePath %>/backoffice/monthly-import-management/exceptions?<%= returnQuery %>">Resolve exceptions</a><a class="btn" href="<%= managementUrl %>#results">Review incomplete records</a></nav>
  <% groups.forEach(group => { %><section class="panel mim-bulk-list"><header><div><span class="eyebrow"><%= group[0] %></span><h2><%= group[1].length %> row(s)</h2></div></header><div class="mim-bulk-rows"><% group[1].forEach(row=>{ %><article class="<%= group[2] %>"><strong><%= row.customer_name||row.account_number||row.phone_original||('Action #'+(row.action_id||'unknown')) %></strong><span><%= row.reference||('Action #'+(row.action_id||'unknown')) %><%= row.source?' · '+row.source:'' %></span><small><%= row.reason||'Applied safely after locked revalidation.' %></small></article><% }) %><% if(!group[1].length){ %><p>None.</p><% } %></div></section><% }) %>
</main>
<link rel="stylesheet" href="<%= basePath %>/public/css/monthly-import-management.css?v=<%= encodeURIComponent(appVersion) %>-bulk-safe">
