<div class="import-centre">
  <header class="import-header">
    <div>
      <span class="eyebrow">Administration</span>
      <h1>Data Import Centre</h1>
      <p>Upload monthly reports, open batches and review proposed matches.</p>
    </div>
    <a class="button secondary compact" href="<%= basePath %>/backoffice<%= panelMode?'?panel=1':'' %>">Back to Administration</a>
  </header>

  <nav class="import-tabs" aria-label="Data Import Centre">
    <% [['overview','Overview'],['upload','Upload Report'],['history','Import History'],['review','Matching Review']].forEach(([value,label])=>{ %>
      <a class="<%= activeTab===value?'active':'' %>" href="<%= basePath %>/backoffice/data-import?tab=<%= value %><%= panelMode?'&panel=1':'' %>"><%= label %></a>
    <% }) %>
  </nav>

  <% if (notice) { %><div class="notice success"><%= notice %></div><% } %>
  <% if (error) { %><div class="notice error"><%= error %></div><% } %>

  <% if (!schemaReady) { %>
    <section class="card setup-card">
      <h2>Database setup required</h2>
      <p>Back up the database and apply only <code>sql/ONE_OFF_057_monthly_data_import.sql</code>. Do not run the generic migration command.</p>
    </section>
  <% } else if (selectedBatch) { %>
    <section class="batch-summary card">
      <div class="batch-summary-main">
        <a class="back-link" href="<%= basePath %>/backoffice/data-import?tab=<%= reviewMode?'review':'history' %><%= panelMode?'&panel=1':'' %>">&larr; Back to <%= reviewMode?'Matching Review':'Import History' %></a>
        <div class="heading">
          <div class="min-width-zero">
            <span class="eyebrow">Batch #<%= selectedBatch.id %></span>
            <h2 class="safe-filename" title="<%= selectedBatch.original_filename %>"><%= selectedBatch.original_filename %></h2>
          </div>
          <b class="status-pill <%= selectedBatch.status %>"><%= selectedBatch.status %></b>
        </div>
        <div class="batch-meta">
          <span><strong><%= selectedBatch.import_type.replaceAll('_',' ') %></strong> from <%= selectedBatch.source_system %></span>
          <span><strong><%= selectedBatch.total_rows %></strong> rows</span>
          <% if(selectedBatch.confirmed_at){ %><span>Confirmed <strong><%= formatDate(selectedBatch.confirmed_at) %></strong></span><% } %>
        </div>
      </div>
      <div class="batch-actions">
        <% if (selectedBatch.status === 'preview') { %>
          <form method="post" action="<%= basePath %>/backoffice/data-import/batches/<%= selectedBatch.id %>/confirm<%= panelMode?'?panel=1':'' %>"><button>Confirm Batch</button></form>
        <% } %>
        <% if (selectedBatch.status === 'confirmed' && matchingSchemaReady) { %>
          <form method="post" action="<%= basePath %>/backoffice/data-import/batches/<%= selectedBatch.id %>/match<%= panelMode?'?panel=1':'' %>"><button>Run Matching</button></form>
          <a class="button secondary" href="<%= basePath %>/backoffice/data-import/batches/<%= selectedBatch.id %>/review<%= panelMode?'?panel=1':'' %>">Review Matches</a>
        <% } %>
        <% if (reviewMode) { %><a class="button secondary" href="<%= basePath %>/backoffice/data-import/batches/<%= selectedBatch.id %><%= panelMode?'?panel=1':'' %>">Open Batch</a><% } %>
      </div>
    </section>

    <% if (!matchingSchemaReady) { %>
      <div class="phase-notice warning"><strong>Matching review setup required</strong><p>Apply the reviewed Phase 2 one-off SQL before running matching.</p></div>
    <% } %>

    <% if (reviewMode) { %>
      <section class="phase-notice">
        <strong>Review only: approval does not modify live customer records</strong>
        <p>Phase 2 stores proposed links and management decisions for a later apply phase.</p>
      </section>
      <section class="match-kpis" aria-label="Matching summary">
        <article><span>Mobile exact</span><strong><%= Number(reviewSummary.mobile_exact||0) %></strong></article>
        <article><span>Mobile conflicts</span><strong><%= Number(reviewSummary.mobile_conflicts||0) %></strong></article>
        <article><span>Mobile unmatched</span><strong><%= Number(reviewSummary.mobile_new||0) %></strong></article>
        <article><span>Fixed matches</span><strong><%= Number(reviewSummary.fixed_exact||0) %></strong></article>
        <article><span>Pending</span><strong><%= Number(reviewSummary.pending||0) %></strong></article>
      </section>
      <nav class="review-filters" aria-label="Match review filters">
        <% [['all','All'],['exact','Exact'],['conflict','Conflicts'],['new','Unmatched / new'],['approved','Approved'],['rejected','Rejected'],['deferred','Deferred']].forEach(([value,label])=>{ %>
          <a class="<%= reviewFilter===value?'active':'' %>" href="<%= basePath %>/backoffice/data-import/batches/<%= selectedBatch.id %>/review?filter=<%= value %><%= panelMode?'&panel=1':'' %>"><%= label %></a>
        <% }) %>
      </nav>

      <% if (!reviewRows.length) { %>
        <section class="card empty-state"><h2>No matches in this view</h2><p>Run matching for this confirmed batch, or choose another filter.</p></section>
      <% } %>
      <section class="review-list" aria-label="Matching results">
        <% reviewRows.forEach(row=>{ %>
          <article class="match-card">
            <header class="match-card-header">
              <div><span class="eyebrow">Row <%= row.source_row_number %> &middot; <%= row.match_domain %></span><strong><%= row.phone_original||row.phone_normalised||row.account_number||'Imported record' %></strong></div>
              <div class="match-badges"><span class="classification <%= row.classification %>"><%= row.classification.replaceAll('_',' ') %></span><span class="review-state <%= row.review_status %>"><%= row.review_status %></span></div>
            </header>
            <div class="match-card-grid">
              <section>
                <h3>Imported data</h3>
                <% if(row.customer_name){ %><p><strong><%= row.customer_name %></strong></p><% } %>
                <% if(row.account_number){ %><p>Account <strong><%= row.account_number %></strong></p><% } %>
                <% if(row.order_number){ %><p>Order <%= row.order_number %></p><% } %>
                <% if(row.solution_id){ %><p>Solution <%= row.solution_id %></p><% } %>
                <% if(row.transaction_date){ %><p><%= formatDate(row.transaction_date) %></p><% } %>
              </section>
              <section>
                <h3>Proposed record</h3>
                <% if(row.proposed_client_id){ %><p><strong>Client #<%= row.proposed_client_id %></strong><br><%= row.proposed_client_name||'Existing mobile client' %></p><% } %>
                <% if(row.proposed_account_id){ %><p><strong>Account #<%= row.proposed_account_id %></strong><br><%= row.proposed_account_number||row.proposed_account_name||'Existing account' %></p><% } %>
                <% if(row.proposed_fixed_account_id){ %><p>Fixed account #<%= row.proposed_fixed_account_id %><%= row.proposed_fixed_account_name?' - '+row.proposed_fixed_account_name:'' %></p><% } %>
                <% if(row.proposed_fixed_service_id){ %><p>Service #<%= row.proposed_fixed_service_id %><%= row.proposed_service_title||row.proposed_service_branch?' - '+(row.proposed_service_title||row.proposed_service_branch):'' %></p><% } %>
                <% if(!row.proposed_client_id&&!row.proposed_account_id&&!row.proposed_fixed_account_id&&!row.proposed_fixed_service_id){ %><p>No existing target proposed.</p><% } %>
                <small>Action: <%= (row.action_type||'-').replaceAll('_',' ') %></small>
              </section>
              <section>
                <h3>Match reason</h3>
                <p class="confidence"><strong><%= Number(row.confidence_score||0) %>% confidence</strong></p>
                <p><%= row.match_reason %></p>
              </section>
              <section class="decision-section">
                <h3>Management decision</h3>
                <form class="decision-form" method="post" action="<%= basePath %>/backoffice/data-import/batches/<%= selectedBatch.id %>/matches/<%= row.id %>/decision<%= panelMode?'?panel=1':'' %>">
                  <input type="hidden" name="return_filter" value="<%= reviewFilter %>">
                  <% if((row.candidates.clients||[]).length>1){ %>
                    <label>Client<select name="client_id"><option value="">Choose client</option><% row.candidates.clients.forEach(candidate=>{ %><option value="<%= candidate.id %>" <%= Number(row.proposed_client_id)===Number(candidate.id)?'selected':'' %>>#<%= candidate.id %> &middot; <%= candidate.clientName||'Unnamed client' %></option><% }) %></select></label>
                  <% } %>
                  <% if((row.candidates.accounts||[]).length>1){ %>
                    <label>Customer account<select name="account_id"><option value="">Choose account</option><% row.candidates.accounts.forEach(candidate=>{ %><option value="<%= candidate.id %>" <%= Number(row.proposed_account_id)===Number(candidate.id)?'selected':'' %>>#<%= candidate.id %> &middot; <%= candidate.accountNumber||candidate.displayName||'Account' %></option><% }) %></select></label>
                  <% } %>
                  <% if((row.candidates.fixedAccounts||[]).length>1 && !(row.candidates.services||[]).length){ %>
                    <label>Fixed account<select name="fixed_account_id"><option value="">Choose fixed account</option><% row.candidates.fixedAccounts.forEach(candidate=>{ %><option value="<%= candidate.id %>" <%= Number(row.proposed_fixed_account_id)===Number(candidate.id)?'selected':'' %>>#<%= candidate.id %> &middot; <%= candidate.customerName||candidate.accountNumber||'Fixed account' %></option><% }) %></select></label>
                  <% } %>
                  <% if((row.candidates.services||[]).length>1){ %>
                    <label>Fixed service<select name="fixed_service_id"><option value="">Choose service</option><% row.candidates.services.forEach(candidate=>{ %><option value="<%= candidate.id %>" <%= Number(row.proposed_fixed_service_id)===Number(candidate.id)?'selected':'' %>>#<%= candidate.id %> &middot; <%= candidate.title||candidate.solutionId||candidate.orderNumber||'Service' %></option><% }) %></select></label>
                  <% } %>
                  <textarea name="review_notes" rows="2" maxlength="2000" placeholder="Review note"><%= row.review_notes||'' %></textarea>
                  <div class="decision-actions"><button name="decision" value="approve">Approve</button><button class="danger" name="decision" value="reject">Reject</button><button class="secondary" name="decision" value="defer">Defer</button></div>
                  <% if(row.reviewed_by_name){ %><small>Reviewed by <%= row.reviewed_by_name %> &middot; <%= formatDate(row.reviewed_at) %></small><% } %>
                </form>
              </section>
            </div>
          </article>
        <% }) %>
      </section>
    <% } else { %>
      <section class="section-heading"><div><span class="eyebrow">Batch contents</span><h2>Imported rows</h2></div><span><%= batchRows.length %> rows shown</span></section>
      <section class="import-row-list">
        <% batchRows.forEach(row=>{ %>
          <article class="import-row-card">
            <div><span class="eyebrow">Row <%= row.source_row_number %></span><strong><%= row.phone_normalised||row.account_number||'No phone or account' %></strong></div>
            <div><span>Customer</span><strong><%= row.customer_name||'-' %></strong></div>
            <div><span>Date</span><strong><%= formatDate(row.transaction_date) %></strong></div>
            <div><span>Deal / order</span><strong><%= row.deal_sheet_number||row.order_number||'-' %></strong></div>
            <div><span>Status</span><strong><%= row.import_status %></strong></div>
            <% if(row.warning_text){ %><div class="row-warning"><span>Warning</span><strong><%= row.warning_text %></strong></div><% } %>
          </article>
        <% }) %>
      </section>
    <% } %>
  <% } else if (activeTab === 'overview') { %>
    <section class="kpis" aria-label="Import overview">
      <article><span>Batches</span><strong><%= Number(summary.batch_count||0) %></strong></article>
      <article><span>Rows</span><strong><%= Number(summary.rows_read||0) %></strong></article>
      <article><span>Valid</span><strong><%= Number(summary.valid_rows||0) %></strong></article>
      <article><span>Duplicates</span><strong><%= Number(summary.duplicate_rows||0) %></strong></article>
      <article><span>Exceptions</span><strong><%= Number(summary.exception_rows||0) %></strong></article>
    </section>
    <section class="card guidance-card">
      <h2>Monthly report workflow</h2>
      <p>Upload a dealer report, confirm the preview, run matching, then review each proposed link.</p>
      <div class="guidance-actions"><a class="button" href="<%= basePath %>/backoffice/data-import?tab=upload<%= panelMode?'&panel=1':'' %>">Upload Report</a><a class="button secondary" href="<%= basePath %>/backoffice/data-import?tab=history<%= panelMode?'&panel=1':'' %>">Import History</a></div>
      <small>No live customer records are changed during Phase 2 matching or review.</small>
    </section>
  <% } else if (activeTab === 'upload') { %>
    <section class="card upload-card">
      <span class="eyebrow">New monthly import</span><h2>Upload Report</h2>
      <p>Select a B12, Siebel or Fixed Base spreadsheet. You will preview the rows before confirming the batch.</p>
      <form action="<%= basePath %>/backoffice/data-import/upload<%= panelMode?'?panel=1':'' %>" method="post" enctype="multipart/form-data">
        <input type="file" name="dealer_report" accept=".xls,.xlsx" required><button>Parse and Preview</button>
      </form>
      <small>Accepted files: .xls and .xlsx, up to 12 MB. Uploading never overwrites live customers.</small>
    </section>
  <% } else if (activeTab === 'history') { %>
    <section class="section-heading"><div><span class="eyebrow">All uploaded reports</span><h2>Import History</h2></div><span><%= batches.length %> recent batches</span></section>
    <% if(!batches.length){ %><section class="card empty-state"><h2>No imports yet</h2><p>Upload the first monthly dealer report to begin.</p></section><% } %>
    <section class="batch-list">
      <% batches.forEach(batch=>{ %>
        <article class="batch-card">
          <div class="batch-card-main">
            <div class="batch-card-title"><span class="batch-number">#<%= batch.id %></span><strong class="safe-filename" title="<%= batch.original_filename %>"><%= batch.original_filename %></strong><span class="status-pill <%= batch.status %>"><%= batch.status %></span></div>
            <p><%= batch.import_type.replaceAll('_',' ') %> &middot; <%= batch.source_system %> &middot; <%= formatDate(batch.created_at) %></p>
            <div class="batch-stats"><span><strong><%= batch.total_rows %></strong> rows</span><span><strong><%= batch.valid_rows %></strong> valid</span><span><strong><%= batch.duplicate_rows %></strong> duplicates</span><span><strong><%= batch.exception_rows %></strong> exceptions</span><% if(Number(batch.match_count)){ %><span><strong><%= batch.match_count %></strong> matches</span><% } %></div>
          </div>
          <div class="batch-card-actions">
            <a class="button secondary" href="<%= basePath %>/backoffice/data-import/batches/<%= batch.id %><%= panelMode?'?panel=1':'' %>">Open Batch</a>
            <% if(batch.status==='confirmed'&&matchingSchemaReady){ %>
              <form method="post" action="<%= basePath %>/backoffice/data-import/batches/<%= batch.id %>/match<%= panelMode?'?panel=1':'' %>"><button>Run Matching</button></form>
              <a class="button secondary" href="<%= basePath %>/backoffice/data-import/batches/<%= batch.id %>/review<%= panelMode?'?panel=1':'' %>">Review Matches</a>
            <% } %>
          </div>
        </article>
      <% }) %>
    </section>
  <% } else { %>
    <section class="phase-notice">
      <strong>Review only: approval does not modify live customer records</strong>
      <p>Select a confirmed batch to review its proposed matches and management decisions.</p>
    </section>
    <section class="section-heading"><div><span class="eyebrow">Choose a batch</span><h2>Matching Review</h2></div></section>
    <% if(!matchingSchemaReady){ %><div class="phase-notice warning"><strong>Matching review setup required</strong><p>Apply the reviewed Phase 2 one-off SQL before running matching.</p></div><% } %>
    <% if(!batches.some(batch=>batch.status==='confirmed')){ %><section class="card empty-state"><h2>No confirmed batches</h2><p>Confirm an uploaded batch before running matching.</p></section><% } %>
    <section class="batch-list review-batch-list">
      <% batches.filter(batch=>batch.status==='confirmed').forEach(batch=>{ %>
        <article class="batch-card">
          <div class="batch-card-main">
            <div class="batch-card-title"><span class="batch-number">#<%= batch.id %></span><strong class="safe-filename" title="<%= batch.original_filename %>"><%= batch.original_filename %></strong></div>
            <p><%= batch.import_type.replaceAll('_',' ') %> &middot; <%= batch.source_system %> &middot; confirmed <%= formatDate(batch.confirmed_at) %></p>
            <div class="batch-stats"><span><strong><%= batch.total_rows %></strong> rows</span><span><strong><%= Number(batch.match_count||0) %></strong> matching results</span></div>
          </div>
          <div class="batch-card-actions">
            <% if(matchingSchemaReady){ %>
              <form method="post" action="<%= basePath %>/backoffice/data-import/batches/<%= batch.id %>/match<%= panelMode?'?panel=1':'' %>"><button>Run Matching</button></form>
              <a class="button secondary" href="<%= basePath %>/backoffice/data-import/batches/<%= batch.id %>/review<%= panelMode?'?panel=1':'' %>">Review Matches</a>
            <% } %>
            <a class="button secondary" href="<%= basePath %>/backoffice/data-import/batches/<%= batch.id %><%= panelMode?'?panel=1':'' %>">Open Batch</a>
          </div>
        </article>
      <% }) %>
    </section>
  <% } %>
</div>
<link rel="stylesheet" href="<%= basePath %>/public/css/monthly-data-import.css?v=<%= encodeURIComponent(appVersion) %>">
