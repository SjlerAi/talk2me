<div class="import-centre">
  <header class="import-header">
    <div>
      <span class="eyebrow">Administration</span>
      <h1>Monthly Import</h1>
      <p>Upload the month’s reports, process them together, resolve exceptions, then finalise once.</p>
    </div>
    <% if (!selectedBatch) { %>
      <a class="button secondary compact" href="#history">Technical history</a>
    <% } %>
  </header>

  <% if (notice) { %><div class="flash success"><%= notice %></div><% } %>
  <% if (error) { %><div class="flash error"><strong>Monthly Import was not changed.</strong><br><%= error %></div><% } %>
  <% if (!schemaReady) { %>
    <div class="phase-notice warning">
      <strong>Monthly Import setup is required</strong>
      <p>Apply the reviewed one-off SQL files manually before using this page. Do not run the generic migration system.</p>
    </div>
  <% } %>

  <% if (selectedBatch) { %>
    <section class="card batch-detail-header">
      <a class="back-link" href="<%= basePath %>/backoffice/data-import<%= panelMode?'?panel=1':'' %>">&larr; Back to Monthly Import</a>
      <div class="heading">
        <div class="min-width-zero">
          <span class="eyebrow">Technical batch #<%= selectedBatch.id %></span>
          <h2 class="safe-filename" title="<%= selectedBatch.original_filename %>"><%= selectedBatch.original_filename %></h2>
        </div>
        <span class="status-pill <%= selectedBatch.status %>"><%= selectedBatch.status %></span>
      </div>
      <div class="batch-meta">
        <span><strong><%= selectedBatch.import_type.replaceAll('_',' ') %></strong></span>
        <span><%= selectedBatch.source_system %></span>
        <span><strong><%= selectedBatch.total_rows %></strong> rows</span>
      </div>
      <div class="batch-actions">
        <% if (selectedBatch.status === 'preview') { %>
          <form method="post" action="<%= basePath %>/backoffice/data-import/batches/<%= selectedBatch.id %>/confirm<%= panelMode?'?panel=1':'' %>">
            <button>Confirm legacy batch</button>
          </form>
        <% } %>
        <% if (matchingSchemaReady && selectedBatch.status === 'confirmed') { %>
          <form method="post" action="<%= basePath %>/backoffice/data-import/batches/<%= selectedBatch.id %>/match<%= panelMode?'?panel=1':'' %>">
            <button>Re-run batch matching</button>
          </form>
          <a class="button secondary" href="<%= basePath %>/backoffice/data-import/batches/<%= selectedBatch.id %>/review<%= panelMode?'?panel=1':'' %>">Technical match review</a>
        <% } %>
        <% if (reviewMode) { %>
          <a class="button secondary" href="<%= basePath %>/backoffice/data-import/batches/<%= selectedBatch.id %><%= panelMode?'?panel=1':'' %>">View rows</a>
        <% } %>
      </div>
    </section>

    <% if (reviewMode) { %>
      <section class="section-heading"><div><span class="eyebrow">Technical view</span><h2>All matching results</h2></div></section>
      <section class="review-list">
        <% reviewRows.forEach(row => { %>
          <article class="match-card">
            <header class="match-card-header">
              <div><span class="eyebrow">Row <%= row.source_row_number %> · <%= row.match_domain %></span><strong><%= row.phone_original||row.account_number||'Imported row' %></strong></div>
              <div class="match-badges"><span class="classification <%= row.classification %>"><%= row.classification.replaceAll('_',' ') %></span><span class="review-state <%= row.review_status %>"><%= row.review_status %></span></div>
            </header>
            <div class="match-card-grid">
              <section><h3>Imported</h3><p><%= row.customer_name||row.package_name||'-' %></p><p><%= row.order_number||row.solution_id||'' %></p></section>
              <section><h3>Reason</h3><p><%= row.match_reason %></p><small><%= Number(row.confidence_score||0) %>% confidence</small></section>
              <section class="decision-section">
                <h3>Decision</h3>
                <form class="decision-form conflict-decision-form" data-conflict-decision method="post" action="<%= basePath %>/backoffice/data-import/batches/<%= selectedBatch.id %>/matches/<%= row.id %>/decision<%= panelMode?'?panel=1':'' %>">
                  <input type="hidden" name="return_filter" value="<%= reviewFilter %>">
                  <% if(panelMode){ %><input type="hidden" name="panel" value="1"><% } %>
                  <%- include('partials/monthly-import-candidate-cards', { row }) %>
                  <textarea name="review_notes" rows="2" maxlength="2000" placeholder="Review note"><%= row.review_notes||'' %></textarea>
                  <div class="decision-actions">
                    <% if (row.selection) { %><button data-use-selected disabled name="decision" value="approve"><%= row.selection.buttonLabel %></button><% } %>
                    <button class="danger" formnovalidate name="decision" value="reject">Exclude this imported row</button>
                    <button class="secondary" formnovalidate name="decision" value="defer">Defer decision</button>
                  </div>
                </form>
              </section>
            </div>
          </article>
        <% }) %>
      </section>
    <% } else { %>
      <section class="section-heading"><div><span class="eyebrow">Technical view</span><h2>Imported rows</h2></div><span><%= batchRows.length %> rows</span></section>
      <section class="import-row-list">
        <% batchRows.forEach(row => { %>
          <article class="import-row-card">
            <div><span class="eyebrow">Row <%= row.source_row_number %></span><strong><%= row.phone_normalised||row.account_number||'No key' %></strong></div>
            <div><span>Customer</span><strong><%= row.customer_name||'-' %></strong></div>
            <div><span>Date</span><strong><%= formatDate(row.transaction_date) %></strong></div>
            <div><span>Status</span><strong><%= row.import_status %></strong></div>
            <% if (row.warning_text) { %><div class="row-warning"><span>Warning</span><strong><%= row.warning_text %></strong></div><% } %>
          </article>
        <% }) %>
      </section>
    <% } %>
  <% } else { %>
    <nav class="workflow-steps" aria-label="Monthly Import steps">
      <a href="#upload"><span>1</span><strong>Upload Files</strong></a>
      <a href="#process"><span>2</span><strong>Process Monthly Import</strong></a>
      <a href="#exceptions"><span>3</span><strong>Review Exceptions</strong></a>
      <a href="#finalise"><span>4</span><strong>Technical History</strong></a>
    </nav>

    <section id="upload" class="workflow-card">
      <div class="step-number">1</div>
      <div class="workflow-content">
        <span class="eyebrow">Upload Files</span>
        <h2>Add this month’s reports</h2>
        <p>Select one or more B12, Siebel, or Fixed Base spreadsheets. Recognised rows are confirmed for processing automatically; exact duplicate files and source rows are not imported twice.</p>
        <form class="upload-form" action="<%= basePath %>/backoffice/data-import/upload<%= panelMode?'?panel=1':'' %>" method="post" enctype="multipart/form-data">
          <input type="file" name="dealer_reports" accept=".xls,.xlsx" multiple required>
          <button <%= !schemaReady?'disabled':'' %>>Upload Files</button>
        </form>
        <small>Up to 10 files per upload, 12 MB each. Uploading does not change customer records.</small>
      </div>
    </section>

    <section id="process" class="workflow-card">
      <div class="step-number">2</div>
      <div class="workflow-content">
        <span class="eyebrow">Process Monthly Import</span>
        <h2>Match all ready rows together</h2>
        <p>Processing is idempotent. Only unique, canonical-phone or unique fixed-service exact matches are approved automatically. New records are prepared for the finalisation preview; conflicts stay pending.</p>
        <div class="summary-strip">
          <span><strong><%= Number(workflow.readyToProcess||0) %></strong> batches ready</span>
          <span><strong><%= Number(summary.valid_rows||0) %></strong> valid rows this month</span>
          <span><strong><%= Number(summary.duplicate_rows||0) %></strong> duplicates skipped</span>
        </div>
        <form method="post" action="<%= basePath %>/backoffice/data-import/process<%= panelMode?'?panel=1':'' %>">
          <button <%= !matchingSchemaReady?'disabled':'' %>>Process Monthly Import</button>
        </form>
      </div>
    </section>

    <section id="exceptions" class="workflow-card">
      <div class="step-number">3</div>
      <div class="workflow-content">
        <span class="eyebrow">Review only conflicts and exceptions</span>
        <h2><%= Number(workflow.conflicts||0) + Number(exceptions.length||0) %> item(s) need attention</h2>
        <p>Exact matches and proposed safe new records do not need row-by-row review. Resolve a conflict, or explicitly reject/defer it. Conflicts are never automatically applied.</p>
        <% if(error){ %><div class="conflict-inline-error" role="alert"><strong>Conflict not updated</strong><span><%= error %></span></div><% } %>

        <% if (!conflicts.length && !exceptions.length) { %>
          <div class="empty-state compact"><strong>No conflicts or source exceptions</strong><p>This step is clear.</p></div>
        <% } %>

        <div class="exception-list">
          <% conflicts.forEach(row => { %>
            <article class="exception-card">
              <header>
                <div><span class="eyebrow"><%= row.original_filename %> · row <%= row.source_row_number %></span><strong><%= row.phone_original||row.account_number||row.customer_name||'Imported row' %></strong></div>
                <span class="review-state <%= row.review_status %>"><%= row.review_status %></span>
              </header>
              <div class="imported-conflict-card">
                <span class="eyebrow">Imported record</span>
                <div class="imported-conflict-grid">
                  <span><b>Source</b><%= row.original_filename %> · row <%= row.source_row_number %></span>
                  <span><b>Name</b><%= row.customer_name||'-' %></span>
                  <% if(row.phone_original||row.phone_normalised){ %><span><b>Original phone</b><%= row.phone_original||'-' %></span><span><b>Canonical phone</b><%= row.imported_canonical_phone||row.phone_normalised||'-' %></span><% } %>
                  <% if(row.account_number){ %><span><b>Account</b><%= row.account_number %></span><% } %>
                  <% if(row.transaction_date){ %><span><b>Transaction / upgrade</b><%= formatDate(row.transaction_date) %></span><% } %>
                  <% if(row.package_name){ %><span><b>Package</b><%= row.package_name %></span><% } %>
                  <% if(row.order_number){ %><span><b>Order</b><%= row.order_number %></span><% } %>
                  <% if(row.solution_id){ %><span><b>Solution</b><%= row.solution_id %></span><% } %>
                  <% if(row.mac_address){ %><span><b>MAC</b><%= row.mac_address %></span><% } %>
                  <% if(row.sim_number){ %><span><b>SIM</b><%= row.sim_number %></span><% } %>
                </div>
                <p><%= row.match_reason %></p>
              </div>
              <form class="decision-form conflict-decision-form" data-conflict-decision method="post" action="<%= basePath %>/backoffice/data-import/batches/<%= row.batch_id %>/matches/<%= row.id %>/decision<%= panelMode?'?panel=1':'' %>">
                <input type="hidden" name="return_to" value="monthly">
                <% if(panelMode){ %><input type="hidden" name="panel" value="1"><% } %>
                <%- include('partials/monthly-import-candidate-cards', { row }) %>
                <textarea name="review_notes" rows="2" maxlength="2000" placeholder="Review note"><%= row.review_notes||'' %></textarea>
                <div class="decision-actions">
                  <% if (row.selection) { %><button data-use-selected disabled name="decision" value="approve"><%= row.selection.buttonLabel %></button><% } %>
                  <button class="danger" formnovalidate name="decision" value="reject">Exclude this imported row</button>
                  <button class="secondary" formnovalidate name="decision" value="defer">Defer decision</button>
                </div>
              </form>
            </article>
          <% }) %>
          <% exceptions.forEach(row => { %>
            <article class="exception-card source-exception">
              <header><div><span class="eyebrow"><%= row.original_filename %> · row <%= row.source_row_number %></span><strong>Source row excluded</strong></div><span class="review-state rejected">exception</span></header>
              <p><%= row.warning_text||'This row did not pass source validation.' %></p>
              <small>Correct this row in the source report and upload the corrected file. It will not be finalised.</small>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <section id="finalise" class="workflow-card finalise-card">
      <div class="step-number">4</div>
      <div class="workflow-content">
        <span class="eyebrow">Technical history</span>
        <h2>Legacy finalisation is no longer used</h2>
        <p>Only records classified as safe may be approved through Monthly Import Management. This page cannot apply imported records.</p>
        <div class="finalise-preview">
          <article><span>Matched mobile updates</span><strong><%= Number(workflow.mobileUpdates||0) %></strong><small>Trusted non-empty fields are preserved.</small></article>
          <article><span>Matched fixed updates</span><strong><%= Number(workflow.fixedUpdates||0) %></strong><small>Unique service identifiers are checked again.</small></article>
          <article><span>New provisional mobile</span><strong><%= Number(workflow.provisionalMobile||0) %></strong><small>Uses the safe account-assignment workflow.</small></article>
          <article><span>New fixed services</span><strong><%= Number(workflow.fixedCreates||0) %></strong><small>Only under a matched customer account.</small></article>
          <article><span>Excluded / deferred</span><strong><%= Number(workflow.excluded||0) %></strong><small>No live write.</small></article>
          <article><span>Already finalised</span><strong><%= Number(workflow.finalised||0) %></strong><small>Skipped on every repeat run.</small></article>
        </div>
        <div class="phase-notice warning"><strong>Legacy finalisation is blocked</strong><p><%= Number(workflow.unresolved||0) %> outstanding exception(s) still need attention. Preview and finalise safe records through the protected bulk workflow.</p></div>
        <nav class="finalise-form">
          <a class="button-link" href="<%= basePath %>/backoffice/monthly-import-management<%= panelMode?'?panel=1':'' %>">Open Monthly Import Management</a>
          <a class="button-link secondary" href="<%= basePath %>/backoffice/monthly-import-management/exceptions<%= panelMode?'?panel=1':'' %>">Resolve exceptions</a>
        </nav>
      </div>
    </section>

    <details id="history" class="card technical-history">
      <summary><span><strong>Technical Import History</strong><small>Batch-level diagnostics and reprocessing controls</small></span><span><%= batches.length %> recent batches</span></summary>
      <div class="batch-list">
        <% batches.forEach(batch => { %>
          <article class="batch-card">
            <div class="batch-card-main">
              <div class="batch-card-title"><span class="batch-number">#<%= batch.id %></span><strong class="safe-filename"><%= batch.original_filename %></strong><span class="status-pill <%= batch.status %>"><%= batch.status %></span></div>
              <p><%= batch.import_type.replaceAll('_',' ') %> · <%= batch.source_system %> · <%= formatDate(batch.created_at) %></p>
              <div class="batch-stats"><span><strong><%= batch.total_rows %></strong> rows</span><span><strong><%= batch.valid_rows %></strong> valid</span><span><strong><%= batch.duplicate_rows %></strong> duplicates</span><span><strong><%= batch.exception_rows %></strong> exceptions</span></div>
            </div>
            <div class="batch-card-actions">
              <a class="button secondary" href="<%= basePath %>/backoffice/data-import/batches/<%= batch.id %><%= panelMode?'?panel=1':'' %>">Open Batch</a>
              <% if (batch.status === 'confirmed' && matchingSchemaReady) { %>
                <form method="post" action="<%= basePath %>/backoffice/data-import/batches/<%= batch.id %>/match<%= panelMode?'?panel=1':'' %>"><button>Re-run Matching</button></form>
                <a class="button secondary" href="<%= basePath %>/backoffice/data-import/batches/<%= batch.id %>/review<%= panelMode?'?panel=1':'' %>">Review Matches</a>
              <% } %>
            </div>
          </article>
        <% }) %>
      </div>
    </details>
  <% } %>
</div>
<link rel="stylesheet" href="<%= basePath %>/public/css/monthly-data-import.css?v=<%= encodeURIComponent(appVersion) %>-monthly-import-64">
<script defer src="<%= basePath %>/public/js/monthly-import-conflict-review.js?v=<%= encodeURIComponent(appVersion) %>-conflict-review-66"></script>
