<div class="import-centre">
  <header class="import-hero"><div><span>Administration</span><h1>Data Import Centre</h1><p>Upload and audit monthly B12, Siebel and Fixed Base reports before any customer record is changed.</p></div><a href="<%= basePath %>/backoffice">Back to Administration</a></header>
  <% if (notice) { %><div class="notice success"><%= notice %></div><% } %>
  <% if (error) { %><div class="notice error"><%= error %></div><% } %>
  <% if (!schemaReady) { %>
    <section class="card"><h2>Database setup required</h2><p>Back up the database and apply only:</p><code>sql/ONE_OFF_057_monthly_data_import.sql</code><p>Do not run the generic migration command.</p></section>
  <% } else { %>
    <section class="kpis"><article><span>Batches</span><strong><%= Number(summary.batch_count||0) %></strong></article><article><span>Rows</span><strong><%= Number(summary.rows_read||0) %></strong></article><article><span>Valid</span><strong><%= Number(summary.valid_rows||0) %></strong></article><article><span>Duplicates</span><strong><%= Number(summary.duplicate_rows||0) %></strong></article><article><span>Exceptions</span><strong><%= Number(summary.exception_rows||0) %></strong></article></section>
    <section class="card"><h2>Upload monthly report</h2><form action="<%= basePath %>/backoffice/data-import/upload" method="post" enctype="multipart/form-data"><input type="file" name="dealer_report" accept=".xls,.xlsx" required><button>Parse and preview</button></form><small>Phase 1 stores an audited preview only. It does not overwrite live customers.</small></section>
    <% if (selectedBatch) { %><section class="card"><div class="heading"><div><span>Batch #<%= selectedBatch.id %></span><h2><%= selectedBatch.original_filename %></h2></div><b><%= selectedBatch.status %></b></div><p><strong>Type:</strong> <%= selectedBatch.import_type %> | <strong>Source:</strong> <%= selectedBatch.source_system %> | <strong>Rows:</strong> <%= selectedBatch.total_rows %></p>
      <% if (selectedBatch.status === 'preview') { %><form method="post" action="<%= basePath %>/backoffice/data-import/batches/<%= selectedBatch.id %>/confirm"><button>Confirm audited batch</button></form><% } %>
      <div class="table-wrap"><table><thead><tr><th>Row</th><th>Status</th><th>Phone / Account</th><th>Customer</th><th>Date</th><th>Agent</th><th>Deal / Order</th><th>Warning</th></tr></thead><tbody><% batchRows.forEach(row=>{ %><tr><td><%= row.source_row_number %></td><td><%= row.import_status %></td><td><%= row.phone_normalised||row.account_number||'-' %></td><td><%= row.customer_name||'-' %></td><td><%= row.transaction_date||'-' %></td><td><%= row.agent_code||'-' %></td><td><%= row.deal_sheet_number||row.order_number||'-' %></td><td><%= row.warning_text||'-' %></td></tr><% }) %></tbody></table></div></section><% } %>
    <section class="card"><h2>Import history</h2><div class="table-wrap"><table><thead><tr><th>Batch</th><th>File</th><th>Type</th><th>Source</th><th>Valid</th><th>Duplicate</th><th>Exception</th><th>Status</th><th></th></tr></thead><tbody><% if(!batches.length){ %><tr><td colspan="9">No imports yet.</td></tr><% } %><% batches.forEach(batch=>{ %><tr><td>#<%= batch.id %></td><td><%= batch.original_filename %></td><td><%= batch.import_type %></td><td><%= batch.source_system %></td><td><%= batch.valid_rows %></td><td><%= batch.duplicate_rows %></td><td><%= batch.exception_rows %></td><td><%= batch.status %></td><td><a href="<%= basePath %>/backoffice/data-import/batches/<%= batch.id %>">Open</a></td></tr><% }) %></tbody></table></div></section>
  <% } %>
</div>
<link rel="stylesheet" href="<%= basePath %>/public/css/monthly-data-import.css?v=<%= encodeURIComponent(appVersion) %>">
