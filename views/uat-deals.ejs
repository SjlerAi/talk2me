<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#16a34a">
  <title>Talk2Me Deals</title>
  <link rel="stylesheet" href="<%= basePath %>/public/css/uat-deals.css?v=<%= encodeURIComponent(appVersion) %>-deals-window1">
</head>
<body>
  <main class="deals-app" data-deals-app>
    <header class="deals-head">
      <div class="deals-title">
        <span>Talk2Me</span>
        <h1>Deals</h1>
        <p>Open any deal instantly and show it to a client.</p>
      </div>
      <div class="deals-count" aria-live="polite"><strong data-deals-count>0</strong><span>deals</span></div>
    </header>

    <section class="deals-toolbar">
      <label class="deals-search">
        <span aria-hidden="true">⌕</span>
        <input type="search" autocomplete="off" placeholder="Search deals..." data-deals-search>
      </label>
      <button type="button" class="deals-refresh" data-deals-refresh>Refresh</button>
    </section>

    <section class="deals-results" aria-live="polite">
      <div class="deals-grid" data-deals-grid></div>
      <div class="deals-load-zone" data-deals-load-zone>
        <button type="button" data-deals-load-more hidden>Load more deals</button>
        <span data-deals-status></span>
      </div>
    </section>
  </main>

  <dialog class="deals-viewer" data-deals-viewer>
    <div class="deals-viewer-shell">
      <header>
        <div>
          <span>Deal</span>
          <strong data-deals-viewer-title></strong>
          <small data-deals-viewer-meta></small>
        </div>
        <div class="deals-viewer-actions">
          <a href="#" target="_blank" rel="noopener" data-deals-download>Download original</a>
          <button type="button" data-deals-fullscreen>Full screen</button>
          <button type="button" class="close" data-deals-close aria-label="Close">×</button>
        </div>
      </header>
      <div class="deals-viewer-body" data-deals-viewer-body></div>
    </div>
  </dialog>

  <script id="deals-config" type="application/json"><%- JSON.stringify({basePath,user:{id:currentUser.id,name:currentUser.full_name,role:currentUser.role}}).replace(/</g,'\u003c') %></script>
  <script src="<%= basePath %>/public/js/uat-deals.js?v=<%= encodeURIComponent(appVersion) %>-deals-window1"></script>
</body>
</html>
