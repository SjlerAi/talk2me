<section class="page-head">
  <div>
    <span class="eyebrow">Back Office</span>
    <h1>Base Details Centre</h1>
    <p>Reconcile the Vodacom current mobile base, preserve source history, unify safe account links and maintain activation/upgrade event history.</p>
  </div>
  <a class="btn" href="<%= basePath %>/backoffice/data-import">Open Data Import Centre</a>
</section>

<% if (notice) { %><div class="success-banner"><%= notice %></div><% } %>
<% if (error) { %><div class="phase-notice warning"><strong>Base Details was not changed</strong><p><%= error %></p></div><% } %>

<% if (!schemaReady) { %>
  <div class="phase-notice warning">
    <strong>Base Details foundation not installed</strong>
    <p>Apply the reviewed PR #110 one-off SQL after the required database backup. Do not use the generic migration runner.</p>
  </div>
<% } else { %>
  <section class="card">
    <span class="eyebrow">Current database layer</span>
    <h2>Mobile base status</h2>
    <div class="summary-strip">
      <span><strong><%= Number(baseSummary.current_lines||0) %></strong> current lines</span>
      <span><strong><%= Number(baseSummary.linked_accounts||0) %></strong> account links</span>
      <span><strong><%= Number(baseSummary.unlinked_accounts||0) %></strong> unresolved account links</span>
      <span><strong><%= Number(baseSummary.linked_clients||0) %></strong> direct client links</span>
      <span><strong><%= Number(baseSummary.eligible_upgrades||0) %></strong> upgrade eligible</span>
      <span><strong><%= Number(baseSummary.churn_risk||0) %></strong> churn risk</span>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px">
      <form method="post" action="<%= basePath %>/backoffice/base-details/unify-accounts"><button class="btn primary">Unify safe account links</button></form>
    </div>
    <small>Only unique account cores are linked automatically. Genuinely missing Base Details accounts may be created once. Ambiguous legacy aliases are left untouched.</small>
  </section>

  <section class="card" style="margin-top:18px">
    <span class="eyebrow">Monthly import protection</span>
    <h2>Pending mobile import re-match</h2>
    <div class="summary-strip">
      <span><strong><%= Number(pendingMobileSummary.pendingRows||0) %></strong> pending rows</span>
      <span><strong><%= Number(pendingMobileSummary.pendingNewCustomerProposals||0) %></strong> pending new-customer proposals</span>
      <span><strong><%= Number(pendingMobileSummary.baseProtected||0) %></strong> already protected by Base Details</span>
      <span><strong><%= Number(pendingMobileSummary.conflicts||0) %></strong> conflicts</span>
    </div>
    <form method="post" action="<%= basePath %>/backoffice/base-details/rematch-pending-mobile" style="margin-top:14px">
      <button class="btn primary">Re-match pending mobile imports</button>
    </form>
    <small>Only still-pending, not-applied activation/upgrade decisions are rechecked. Applied or previously decided records are never reset.</small>
  </section>

  <section class="card" style="margin-top:18px">
    <span class="eyebrow">Transaction history</span>
    <h2>Mobile event ledger</h2>
    <div class="summary-strip">
      <span><strong><%= Number(eventSummary.events||0) %></strong> events</span>
      <span><strong><%= Number(eventSummary.activations||0) %></strong> activations</span>
      <span><strong><%= Number(eventSummary.upgrades||0) %></strong> upgrades</span>
      <span><strong><%= Number(eventSummary.staff_matched||0) %></strong> staff matched</span>
      <span><strong><%= Number(eventSummary.staff_unmapped||0) %></strong> staff code unresolved</span>
    </div>
    <form method="post" action="<%= basePath %>/backoffice/base-details/sync-events" style="margin-top:14px"><button class="btn">Synchronise activation & upgrade history</button></form>
    <small>The ledger is idempotent by import row. Re-running refreshes links and staff mapping without duplicating events.</small>
  </section>

  <section class="card" style="margin-top:18px">
    <h2>Base Details batches</h2>
    <p>Upload the Base Details XLSX through Data Import Centre. Reconcile first. Staging writes only the dedicated current/snapshot layer and never creates or overwrites historical CRM client rows.</p>
    <% if (!batches.length) { %>
      <div class="empty-state compact"><strong>No Base Details batch uploaded yet</strong><p>Use Data Import Centre to upload the Vodacom Base Details workbook.</p></div>
    <% } %>
    <% batches.forEach(batch => { %>
      <article class="card" style="margin-top:16px">
        <div style="display:flex;justify-content:space-between;gap:16px;align-items:flex-start;flex-wrap:wrap">
          <div>
            <span class="eyebrow">Batch #<%= batch.id %> · <%= batch.status %></span>
            <h3><%= batch.original_filename %></h3>
            <p><strong><%= Number(batch.total_rows||0) %></strong> source rows · <strong><%= Number(batch.reconciled_rows||0) %></strong> reconciled · <strong><%= Number(batch.snapshot_rows||0) %></strong> snapshots staged</p>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <form method="post" action="<%= basePath %>/backoffice/base-details/<%= batch.id %>/reconcile"><button class="btn">Reconcile</button></form>
            <% if (Number(batch.reconciled_rows||0) === Number(batch.valid_rows||0) && Number(batch.valid_rows||0) > 0) { %>
              <form method="post" action="<%= basePath %>/backoffice/base-details/<%= batch.id %>/stage"><button class="btn primary">Stage current mobile base</button></form>
            <% } %>
          </div>
        </div>
        <div class="summary-strip" style="margin-top:12px">
          <span><strong><%= Number(batch.exact_matches||0) %></strong> exact existing</span>
          <span><strong><%= Number(batch.possible_matches||0) %></strong> history / alias review</span>
          <span><strong><%= Number(batch.new_records||0) %></strong> new service stages</span>
          <span><strong><%= Number(batch.conflicts||0) %></strong> account conflicts</span>
        </div>
        <div class="summary-strip" style="margin-top:8px">
          <span><strong><%= Number(batch.existing_client||0) %></strong> existing client</span>
          <span><strong><%= Number(batch.existing_history||0) %></strong> same-account history</span>
          <span><strong><%= Number(batch.new_service_existing_account||0) %></strong> new line / existing account</span>
          <span><strong><%= Number(batch.new_service_new_account||0) %></strong> new line / new account</span>
          <span><strong><%= Number(batch.account_alias_review||0) %></strong> account alias review</span>
          <span><strong><%= Number(batch.account_conflicts||0) %></strong> account mismatch</span>
        </div>
      </article>
    <% }) %>
  </section>

  <section class="card" style="margin-top:18px">
    <h2>Base Details exceptions</h2>
    <p>These rows are deliberately not used to overwrite an existing CRM account relationship. The current network source remains preserved while the history discrepancy stays visible for management review.</p>
    <% if (!conflicts.length) { %><div class="empty-state compact"><strong>No Base Details conflicts</strong></div><% } %>
    <% conflicts.forEach(row => { %>
      <article class="exception-card" style="margin-top:12px">
        <header>
          <div><span class="eyebrow">Batch #<%= row.batch_id %> · row <%= row.source_row_number %></span><strong><%= row.phone_normalised || 'No MSISDN' %></strong></div>
          <span class="review-state pending"><%= row.action_type.replaceAll('_',' ') %></span>
        </header>
        <div class="imported-conflict-grid">
          <span><b>Account</b><%= row.account_number || '-' %></span>
          <span><b>Name</b><%= row.customer_name || '-' %></span>
          <span><b>Source</b><%= row.original_filename %></span>
        </div>
        <p><%= row.match_reason %></p>
      </article>
    <% }) %>
  </section>
<% } %>
