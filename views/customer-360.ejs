<section class="customer-head"><div><a href="<%= basePath %>/command-centre">← Command Centre</a><div class="eyebrow">Customer 360 · Talk2Me Customer #<%= client.id %></div><h1><%= client.client_name %></h1><p>Lifecycle <strong><%= client.lifecycle_status||'prospect' %></strong> · Official account <strong><%= accountRecord?.account_number||client.account_number||(pendingAccountRequest?'pending manager allocation':'not captured') %></strong> · <%= lines.length %> line(s) · Assigned to <%= accountRecord?.assigned_staff_name||assignment?.full_name||'Unassigned' %></p></div><div class="hero-actions account-action-row"><a class="btn primary" href="<%= basePath %>/queries/new?client_id=<%= client.id %>">New Inquiry</a><a class="btn primary" href="<%= basePath %>/customers/<%= client.id %>/details">Edit Customer Details</a><a class="btn primary" href="<%= basePath %>/customers/<%= client.id %>/notes/new">Add Internal Note</a><a class="btn primary" href="<%= basePath %>/tasks/new?client_id=<%= client.id %>&q=<%= encodeURIComponent(client.cell_number||client.account_number||client.email||client.client_name||'') %>">Add Task</a><a class="btn opportunity" href="<%= basePath %>/customers/<%= client.id %>/add-mobile">Add Mobile Line</a><a class="btn opportunity" href="<%= basePath %>/customers/<%= client.id %>/add-fixed">Add Fixed Service</a><% if((client.lifecycle_status||'prospect')==='prospect'){ %><form method="post" action="<%= basePath %>/customers/<%= client.id %>/convert-to-client" class="claim-inline" onsubmit="return confirm('Convert this prospect to an active customer? The same Talk2Me customer record and history will be kept.')"><button class="btn opportunity" type="submit">Convert to Active Customer</button></form><% } %><% if(!assignment&&!accountRecord?.assigned_staff_id&&!pendingClaim){ %><form method="post" action="<%= basePath %>/clients/<%= client.id %>/request-claim" class="claim-inline"><% if(panelMode){ %><input type="hidden" name="panel" value="1"><% } %><button class="btn warning" type="submit">Claim client</button></form><% } %><% if(pendingClaim){ %><span class="badge warn">Ownership conflict awaiting owner decision: <%= pendingClaim.requested_by_name %></span><% } %><% if(['owner','manager'].includes(currentUser.role)){ %><a class="btn" href="<%= basePath %>/backoffice/clients/<%= client.id %>/edit">Edit Line</a><% } else { %><a class="btn" href="<%= basePath %>/customers/<%= client.id %>/propose-change">Request Line Change</a><% } %></div></section>
<% if(String(client.lifecycle_status||'prospect')==='prospect'){ %><section class="panel"><div class="eyebrow">Prospect status</div><h2>This prospect is already a customer record in Talk2Me</h2><p>Permanent Talk2Me Customer #<strong><%= client.id %></strong>. Keep adding details to this same record. When the sale is confirmed, use <strong>Convert to Active Customer</strong>; no record is moved or recreated.</p></section><% } %>
<% if(typeof masterServiceConflict!=='undefined'&&masterServiceConflict&&['owner','manager'].includes(currentUser.role)){ %>
<section class="panel" style="border-left:5px solid #c68a32;background:#fff9ee">
  <div class="panel-heading-row">
    <div>
      <div class="eyebrow">Master Customer Register · Unresolved account relationship</div>
      <h2>This telephone number has a conflicting account</h2>
      <p>The CRM and Vodacom source disagree about the account for <strong><%= masterServiceConflict.phone %></strong>.
        This Customer 360 screen is for viewing and editing the CRM record; the account decision is made on the dedicated comparison screen.</p>
    </div>
    <a class="btn primary" href="<%= basePath %>/master-register/service/<%= encodeURIComponent(masterServiceConflict.serviceKey) %>#resolve-account">Resolve this account conflict</a>
  </div>
</section>
<% } %>
<% if(!client.account_number){ %><section class="panel"><div class="eyebrow">Account status</div><h2><%= pendingAccountRequest?'Official account number pending':'Official account number not captured' %></h2><p><%= pendingAccountRequest?'This customer is already saved in Talk2Me. Management must still assign the official unique account number. Staff may continue with inquiries, mobile lines and fixed-service capture.':'This customer is already saved in Talk2Me but has no official unique account number. The permanent Talk2Me Customer #'+client.id+' identifies the record until the official account number is captured. Mobile and fixed work may still be captured.' %></p><% if(pendingAccountRequest){ %><small>Request #<%= pendingAccountRequest.id %> · Requested by <%= pendingAccountRequest.requested_by_name||'staff' %> · <%= new Date(pendingAccountRequest.created_at).toLocaleString('en-ZA') %></small><% } %></section><% } %>
<section class="answer-grid"><div><span>Next upgrade</span><strong><%= client.next_upgrade_date?new Date(client.next_upgrade_date).toLocaleDateString('en-ZA',{dateStyle:'medium'}):'Unknown' %></strong><small><%= client.previous_upgrade_date?'Previous: '+new Date(client.previous_upgrade_date).toLocaleDateString('en-ZA',{dateStyle:'medium'}):'Previous date missing' %> · <%= client.contract_term_months||24 %> months</small></div><div><span>Birthday</span><strong><%= client.birthday?new Date(client.birthday).toLocaleDateString('en-ZA',{dateStyle:'medium'}):'Unknown' %></strong><small><%= client.id_number||'ID not captured' %></small></div><div><span>Contact number</span><strong><%= client.cell_number||'Unknown' %></strong><small>Selected line</small></div><div><span>Email</span><strong><%= client.email||'Unknown' %></strong></div><div><span>Town</span><strong><%= client.city_town&&client.city_town!=='null'?client.city_town:'Unknown' %></strong></div><div><span>Handset</span><strong><%= client.handset||'Unknown' %></strong><small><%= client.package_name||'Package unknown' %></small></div><div><span>Account lines</span><strong><%= lines.length %></strong><small><%= lines.filter(x=>x.line_status==='cancelled').length %> cancelled</small></div></section>
<% if(typeof providerLine!=='undefined'&&providerLine){ %>
<section class="panel" id="viralco-source-details">
  <div class="panel-heading-row">
    <div><div class="eyebrow">Direct ViralCo source • <%= new Date(providerLine.published_at).toLocaleDateString('en-ZA') %></div>
      <h2>Verified Subscriber Details</h2>
      <p>Reported by ViralCo for this mobile line. Fields below remain separate from notes, ownership and invoice charges.</p>
    </div>
    <a class="btn" href="<%= basePath %>/customers/<%= client.id %>/viralco-sync">Account Import History</a>
  </div>
  <div class="answer-grid">
    <div><span>Provider Upgradable</span><strong><%= providerLine.upgradable==='Y'?'Yes':'No' %></strong><small>ViralCo's explicit eligibility flag</small></div>
    <div><span>Earliest eligibility date</span><strong><%= providerLine.eligible_iso||'—' %></strong></div>
    <div><span>Contract end date</span><strong><%= providerLine.term_iso||'—' %></strong></div>
    <div><span>Average spend</span><strong><%= providerLine.avg_spend==null?'—':'R '+Number(providerLine.avg_spend).toFixed(2) %></strong><small>Not the invoice charge</small></div>
    <div><span>Subscriber name</span><strong><%= providerLine.subscriber_name||'—' %></strong></div>
    <div><span>Invoice name</span><strong><%= providerLine.invoice_name||'—' %></strong></div>
    <div><span>Sponsored Account</span><strong><%= providerLine.sponsored_account||'—' %></strong></div>
    <div><span>Activation Date</span><strong><%= providerLine.activation_date?new Date(providerLine.activation_date).toLocaleDateString('en-ZA'):'—' %></strong></div>
    <div><span>Last Upgrade / Activation</span><strong><%= providerLine.last_upgrade_date?new Date(providerLine.last_upgrade_date).toLocaleDateString('en-ZA'):'—' %></strong></div>
    <div><span>Package code</span><strong><%= providerLine.pack_code||'—' %></strong></div>
    <div><span>SIM number</span><strong><%= providerLine.sim_number||'—' %></strong></div>
    <div><span>Dealer ID</span><strong><%= providerLine.dealer_id||'—' %></strong></div>
    <div><span>Line status code</span><strong><%= providerLine.line_status_code||'—' %></strong><small>Provider code, not inferred cancellation</small></div>
    <div><span>Loyalty status</span><strong><%= providerLine.loyalty_status||'—' %></strong></div>
  </div>
</section>
<% } %>
<section class="panel customer-note-callout"><div><div class="eyebrow">Internal customer history</div><h2>Add Internal Note</h2><p>Record what the customer asked, who handled it, who must follow up and when. The note stays permanently linked to this customer and the responsible staff member.</p></div><a class="btn primary" href="<%= basePath %>/customers/<%= client.id %>/notes/new">+ Add Internal Note</a></section>
<% if(assigned){ %><div class="success-box">Client assignment updated successfully.</div><% } %>
<% if(typeof noteSaved!=='undefined'&&noteSaved){ %><div class="success-box">Internal customer note saved and added to the interaction history.</div><% } %>
<% if(typeof detailsSaved!=='undefined'&&detailsSaved){ %><div class="success-box">Customer details saved successfully.</div><% } %>
<% if(typeof converted!=='undefined'&&converted){ %><div class="success-box">Prospect converted to an active customer. The same Talk2Me record and full history were kept.</div><% } %>
<% if(claimRequested){ %><div class="success-box">Client claimed successfully.</div><% } %>
<% if(typeof claimConflict!=='undefined'&&claimConflict){ %><div class="warning-box">This client is already claimed by <%= (typeof claimOwner!=='undefined'&&claimOwner)||'another staff member' %>. A conflict has been sent to the owner for a decision.</div><% } %>
<% if(client.account_number && pendingAccountRequest){ %><section class="panel"><h2>Account or service request awaiting approval</h2><p>The captured account number is shown above. Management must review the pending request before the requested service or account change becomes active.</p><small>Request #<%= pendingAccountRequest.id %></small></section><% } %>
<% if(typeof fixedSaved!=='undefined' && fixedSaved){ %><div class="success-box"><%= fixedSaved==='existing'?'This installation is already saved. No duplicate service was created.':'Fixed service saved successfully against the existing account.' %></div><% } %>
<% if(changeRequested){ %><div class="success-box"><%= changeRequested==='account-number'?'The mobile line was saved and the account-number request was sent to management.':changeRequested==='fixed-account-number'?'The fixed-service request was saved and the account-number request was sent to management.':changeRequested==='fixed-account-link'?'Your fixed-service details are saved for management approval against the existing account number. The service will appear in Fixed Services after approval.':changeRequested==='duplicate-inquiry'?'The inquiry was saved against the existing customer without creating a duplicate line.':'Your '+(changeRequested==='fixed'?'fixed service':'mobile line')+' request was sent to the owner and manager for approval.' %></div><% } %>
<section class="panel assignment-control"><div><div class="eyebrow">Client ownership</div><h2>Assigned Staff Member</h2><p><%= client.account_number?'This assignment applies to every mobile line on account '+client.account_number+'.':'This client has no account number, so the assignment applies to this client record.' %></p></div><% if(['owner','manager'].includes(currentUser.role)){ %><form method="post" action="<%= basePath %>/backoffice/clients/<%= client.id %>/assign"><input type="hidden" name="return_to" value="customer360"><select name="assigned_staff_id"><option value="">Unassigned</option><% assignmentStaff.forEach(s=>{ %><option value="<%= s.id %>" <%= Number(assignment?.id)===Number(s.id)?'selected':'' %>><%= s.full_name %> — <%= s.role %></option><% }) %></select><button class="btn primary" type="submit">Update Assignment</button></form><% } else { %><strong><%= assignment?.full_name||'Unassigned' %></strong><small>Only an owner or manager can change this assignment.</small><% } %></section>
<section class="authority-card <%= client.account_authority_status==='confirmed'?'confirmed':'warning' %>"><div><span>Authorised Account Contact</span><h2><%= client.main_contact_name&&String(client.main_contact_name).toLowerCase()!=='null'?client.main_contact_name:'Not confirmed' %></h2><p><%= client.main_contact_number&&String(client.main_contact_number).toLowerCase()!=='null'?client.main_contact_number:'No authorised contact number' %></p></div><div><span>Authority</span><strong><%= client.account_authority_status==='confirmed'?'Confirmed':client.account_authority_status==='not_authorised'?'Not authorised':'Verification required' %></strong><a href="<%= basePath %>/customers/<%= client.id %>/propose-change">Request authority update</a></div></section>
<% if(accountRecord){ %><section class="panel"><div class="panel-heading-row"><div><div class="eyebrow">Business account records</div><h2>ViralCo Business Account Update</h2><p>Upload the original Subscriber Detailed Report from ViralCo every three months. Preview changes, safely update CRM mobile lines and keep earlier source reports. No manually transcribed spreadsheet required.</p></div><a class="btn primary" href="<%= basePath %>/customers/<%= client.id %>/viralco-sync">Upload / Review ViralCo Report</a></div></section><% } %>
<section class="panel"><h2>Account Lines</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Line</th><th>User / Client</th><th>Package</th><th>Handset</th><th>Previous upgrade</th><th>Next upgrade</th><th>Status</th><th></th></tr></thead><tbody><% lines.forEach(x=>{ %><tr class="<%= x.id===client.id?'selected-line':'' %>"><td><strong><%= x.cell_number||'Unknown' %></strong></td><td><%= x.client_name %></td><td><%= x.package_name||'—' %></td><td><%= x.handset||'—' %></td><td><%= x.previous_upgrade_date?new Date(x.previous_upgrade_date).toLocaleDateString('en-ZA'):'—' %></td><td><strong><%= x.next_upgrade_date?new Date(x.next_upgrade_date).toLocaleDateString('en-ZA'):'—' %></strong></td><td><span class="status-pill <%= x.line_status %>"><%= x.line_status %></span></td><td><a href="<%= basePath %>/customers/<%= x.id %>/360">Open</a></td></tr><% }) %></tbody></table></div></section><% if(typeof pendingFixedServices!=='undefined' && pendingFixedServices.length){ %><section class="panel"><h2>Fixed Services awaiting approval</h2><p>These captured requests are saved but are not active services. Review an existing request instead of entering it again.</p><div class="table-wrap"><table class="data-table"><thead><tr><th>Request</th><th>Branch / site</th><th>Solution / order</th><th>Package</th><th>Status</th></tr></thead><tbody><% pendingFixedServices.forEach(r=>{ %><tr><td>#<%= r.id %></td><td><%= r.branch_name||'—' %></td><td><%= r.solution_id||r.order_number||'—' %></td><td><%= r.package_name||'—' %></td><td>Awaiting approval <% if(['owner','manager','admin'].includes(currentUser.role)){ %><a href="<%= basePath %>/approvals?tab=account_changes&amp;q=<%= r.id %>">Review</a><% } %></td></tr><% }) %></tbody></table></div></section><% } %><% if(fixedAccounts&&fixedAccounts.length){ %><section class="panel" id="fixed-services"><div class="panel-heading-row"><div><div class="eyebrow">Same customer</div><h2>Fixed Services</h2></div><a class="btn primary" href="<%= basePath %>/fixed/accounts/<%= fixedAccounts[0].id %>">Open Fixed Customer 360</a></div><% fixedAccounts.forEach(a=>{ %><a class="mini-client" href="<%= basePath %>/fixed/accounts/<%= a.id %>"><div><strong><%= a.customer_name %></strong><small>Account <%= a.account_number %> · <%= a.fixed_service_count %> fixed service(s)</small></div><span class="search-type fixed">FIXED</span></a><% }) %></section><% } %>
<% if(typeof masterCustomer!=='undefined'&&masterCustomer&&['owner','manager','admin'].includes(currentUser.role)){ %>
<section class="panel" id="master-customer-service-register">
  <div class="panel-heading-row">
    <div>
      <div class="eyebrow">Single Master Customer Register</div>
      <h2>All known services under this account</h2>
      <p>This account has <strong><%= masterCustomer.service_count %></strong> mobile, VoIP, telephone and fixed service entries.
         Original CRM lines above remain editable; supplier-only lines below are source evidence and cannot create new customers by opening them.</p>
    </div>
    <% if(currentUser.role==='owner'){ %><a class="btn primary" href="<%= basePath %>/master-register/customer/<%= encodeURIComponent(masterCustomer.customer_key) %>">Open Master Account</a><% } %>
  </div>
  <% if(masterCustomer.verification_state!=='account_reference'){ %>
    <div class="warning-box">The master account/customer identity is not fully verified. Do not merge these services before the owner resolves the conflict.</div>
  <% } %>
  <div class="table-wrap"><table class="data-table">
    <thead><tr><th>Service</th><th>Type</th><th>Customer relationship</th><th>Source record</th></tr></thead>
    <tbody>
      <% masterServices.forEach(x=>{ %><tr>
        <td><strong><%= x.phone||x.display_name||x.service_key %></strong></td>
        <td><%= x.service_type==='fixed'?'Fixed':x.service_type==='voip'?'VoIP':x.service_type==='mobile'?'Mobile':'Telephone' %></td>
        <td><%= x.link_state==='verified_crm_supplier_link'?'CRM & supplier match':x.link_state==='crm_customer_linked'?'CRM record linked':x.link_state==='account_only_no_customer'?'Account known; individual contact not confirmed':'Check relationship before using' %></td>
        <td>
          <% if(x.crm_client_id&&x.link_state!=='needs_conflict_review'){ %>
            <a href="<%= basePath %>/customers/<%= x.crm_client_id %>/360">Open CRM line</a>
          <% }else if(x.mobile_base_id){ %>
            <a href="<%= basePath %>/mobile-base/<%= x.mobile_base_id %>">View Vodacom source</a>
          <% }else if(currentUser.role==='owner'){ %>
            <a href="<%= basePath %>/master-register/service/<%= encodeURIComponent(x.service_key) %>">View master service</a>
          <% }else{ %>Source retained<% } %>
        </td>
      </tr><% }) %>
    </tbody>
  </table></div>
  <% if(masterCustomer.service_count>masterServices.length){ %>
    <p>Showing the first <%= masterServices.length %> services. Open the Master Account for the complete register.</p>
  <% } %>
</section>
<% } %>
<section class="panel" id="base-details-current-panel" hidden><div class="panel-heading-row"><div><div class="eyebrow">Preserved source truth</div><h2>Current Vodacom / Base Details</h2><p>This information comes from the imported Base Details source and remains read-only. Use the normal Customer 360 controls above for CRM changes.</p></div></div><div id="base-details-current-lines"></div></section>
<section class="command-grid"><div class="panel"><h2>Interaction History</h2><% history.forEach(i=>{ %><a class="timeline-item" href="<%= basePath %>/dashboard/inquiries/<%= i.id %>"><time><%= new Date(i.created_at).toLocaleString('en-ZA') %></time><strong><%= i.category_name||i.category_other||'Customer note' %> · <%= i.status %></strong><p><%= i.query_text||'No inquiry detail' %></p><% if(i.action_taken){ %><p><strong>Note:</strong> <%= i.action_taken %></p><% } %><small><%= i.responsible_name %></small></a><% }) %><% if(!history.length){ %><div class="empty-state">No CRM interactions recorded for this customer yet.</div><% } %></div><div class="panel"><div class="panel-heading-row"><h2>Related Tasks</h2><a class="btn primary" href="<%= basePath %>/tasks/new?client_id=<%= client.id %>&q=<%= encodeURIComponent(client.cell_number||client.account_number||client.email||client.client_name||'') %>">+ Add Task</a></div><% tasks.forEach(t=>{ %><a class="timeline-item" href="<%= basePath %>/tasks/<%= t.id %>"><time><%= new Date(t.created_at).toLocaleString('en-ZA') %></time><strong><%= t.title %></strong><p><%= t.message %></p><small><%= t.assigned_name %> · <%= t.status %></small></a><% }) %><% if(!tasks.length){ %><div class="empty-state">No related tasks.</div><% } %></div></section>
<script>
(()=>{
  const panel=document.getElementById('base-details-current-panel');
  const holder=document.getElementById('base-details-current-lines');
  if(!panel||!holder)return;
  const BASE=<%- JSON.stringify(basePath) %>;
  const clientId=<%- JSON.stringify(client.id) %>;
  const text=v=>v===null||v===undefined||String(v).trim()===''?'—':String(v);
  const date=v=>{if(!v)return '—';const d=new Date(v);return Number.isNaN(d.getTime())?text(v):d.toLocaleDateString('en-ZA',{dateStyle:'medium'});};
  const addField=(grid,label,value)=>{const box=document.createElement('div');const l=document.createElement('span');const s=document.createElement('strong');l.textContent=label;s.textContent=text(value);box.append(l,s);grid.appendChild(box);};
  const addSection=(card,title,fields)=>{const h=document.createElement('h3');h.textContent=title;h.style.margin='16px 0 8px';card.appendChild(h);const grid=document.createElement('div');grid.className='answer-grid';fields.forEach(([label,value])=>addField(grid,label,value));card.appendChild(grid);};
  fetch(`${BASE}/api/uat/customers/${clientId}/base-details`,{credentials:'same-origin',cache:'no-store',headers:{Accept:'application/json'}})
    .then(r=>r.ok?r.json():null)
    .then(data=>{
      if(!data||!data.ok||!Array.isArray(data.rows)||!data.rows.length)return;
      panel.hidden=false;
      data.rows.forEach((line,index)=>{
        const card=document.createElement('article');
        card.className='panel';
        card.style.margin='12px 0 0';
        const heading=document.createElement('div');heading.className='panel-heading-row';
        const copy=document.createElement('div');const eyebrow=document.createElement('div');eyebrow.className='eyebrow';eyebrow.textContent=`Imported service ${index+1}`;
        const h=document.createElement('h2');h.textContent=text(line.msisdn_original||line.msisdn_normalised);
        const p=document.createElement('p');p.textContent=`Account ${text(line.account_code)} · ${text(line.account_name)}`;
        copy.append(eyebrow,h,p);
        const source=document.createElement('a');source.className='btn';source.href=`${BASE}/mobile-base/${line.id}?source=1`;source.textContent='View full source record';
        heading.append(copy,source);card.appendChild(heading);
        addSection(card,'Customer & account',[
          ['Business unit',line.business_unit],['First name',line.first_name],['Surname',line.surname],['ID number',line.id_number],['Email',line.email_address],['Master account holder',line.master_account_holder]
        ]);
        addSection(card,'Contract, plan & device',[
          ['Contract status',line.contract_status],['Contract period',line.contract_period],['Connection date',date(line.connection_date)],['Last active',date(line.last_active_date)],['Last upgrade',date(line.last_upgrade_date)],['Eligible upgrade',date(line.eligible_upgrade_date)],['Eligible flag',line.eligible_upgrade_flag],['Device',[line.device_manufacturer,line.device_name].filter(Boolean).join(' ')],['Price plan',line.price_plan],['Tariff',line.tariff_name],['Base dealer',line.base_dealer_name]
        ]);
        addSection(card,'Usage, revenue & risk',[
          ['Subscription revenue excl VAT',line.subscription_revenue_excl_vat],['Revenue M1',line.customer_revenue_m1],['Revenue M2',line.customer_revenue_m2],['Revenue M3',line.customer_revenue_m3],['Data usage M1 MB',line.data_usage_m1_mb],['Data usage M2 MB',line.data_usage_m2_mb],['Data usage M3 MB',line.data_usage_m3_mb],['Account in arrears',line.account_in_arrears],['Churn risk',line.churn_risk_ind],['Portfolio score',line.portfolio_score]
        ]);
        addSection(card,'SIM & source history',[
          ['SIM size',line.sim_size_description],['ICCID',line.icc_id],['IMSI',line.imsi],['Device insurance',line.device_insurance],['SIM insurance',line.sim_insurance],['Source snapshots',line.snapshot_count]
        ]);
        const recs=[line.recommendation_1,line.recommendation_2,line.recommendation_3,line.recommendation_4].filter(Boolean);
        if(recs.length){const h3=document.createElement('h3');h3.textContent='Recommendations';h3.style.margin='16px 0 8px';card.appendChild(h3);recs.forEach((r,i)=>{const p=document.createElement('p');p.textContent=`${i+1}. ${r}`;card.appendChild(p);});}
        holder.appendChild(card);
      });
    }).catch(()=>{});
})();
</script>
