<style>
.cleanup-wrap{max-width:1350px;margin:auto;color:var(--text-primary,#1d2c3d)}
.cleanup-header{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:15px}
.cleanup-header h1{font-size:1.6rem;margin:3px 0}.cleanup-header p{margin:0}
.cleanup-warning{padding:14px 16px;background:#fff3cf;color:#5d450e;border-left:5px solid #d7a41b;border-radius:8px;margin:10px 0 18px}
.cleanup-note-box{background:#e9f7ef;color:#1e5946;border-radius:8px;padding:12px;margin:12px 0}
.cleanup-nav{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 22px}
.cleanup-nav a{display:inline-flex;padding:10px 13px;border-radius:8px;background:#edf2f8;border:1px solid #b4c7da;color:#14304a;text-decoration:none;font-weight:600}
.cleanup-nav a.active{background:#133b65;color:#fff}
.cleanup-card{border:1px solid #bccbdc;border-radius:12px;padding:18px;margin:12px 0;background:#fff;color:#1a2836}
.cleanup-card a{color:#075999}.cleanup-card h3{margin:3px 0 12px}
.cleanup-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:15px}
.cleanup-line{background:#f5f8fb;border:1px solid #dce6f0;border-radius:10px;padding:14px;overflow-wrap:anywhere}
.cleanup-line header{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:center}
.cleanup-line dl{display:grid;grid-template-columns:1fr 1fr;gap:5px 8px;margin:10px 0 0}
.cleanup-line dt{font-weight:650;font-size:.82rem;color:#506479}.cleanup-line dd{margin:0 0 8px}
.cleanup-form{border-top:1px solid #d2dfea;margin-top:15px;padding-top:15px}
.cleanup-form .fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:9px}
.cleanup-form label{font-weight:600;font-size:.86rem;display:block}.cleanup-form input:not([type=checkbox]),.cleanup-form select,.cleanup-form textarea{width:100%;border:1px solid #a8bad0;border-radius:7px;padding:8px;box-sizing:border-box;background:#fff;color:#1c2a39}
.cleanup-form textarea{min-height:70px;margin:5px 0 10px}.cleanup-form .confirm label{display:flex;align-items:flex-start;gap:8px;margin:8px 0}
.cleanup-form input[type=checkbox],.cleanup-form input[type=radio]{width:auto!important;margin:4px}
.cleanup-btn{border:0;background:#126655;color:#fff;padding:10px 16px;border-radius:8px;cursor:pointer;font-weight:650}
.cleanup-btn.secondary{background:#26476b}.cleanup-btn.danger{background:#8c3b29}
.cleanup-table{width:100%;border-collapse:collapse}.cleanup-table th,.cleanup-table td{padding:11px 9px;text-align:left;border-bottom:1px solid #d9e3ed;vertical-align:top}
.cleanup-scroll{overflow-x:auto}.cleanup-pager{display:flex;gap:16px;margin:18px 0}
.cleanup-pill{display:inline-block;border-radius:20px;background:#e6edf5;padding:4px 10px;font-size:.82rem;color:#294766}
.cleanup-search{display:flex;gap:9px;flex-wrap:wrap;align-items:center}.cleanup-search input,.cleanup-search select{padding:9px;border:1px solid #a7b9ce;border-radius:7px}
.cleanup-radio{display:block;margin:10px 0}.cleanup-radio input{margin-right:8px}.cleanup-small{font-size:.86rem;color:#4e6175}
.cleanup-label{font-weight:600}.cleanup-toggle{margin:12px 0 0}.cleanup-toggle summary{cursor:pointer;font-weight:700;color:#14527e}
</style>
<section class="cleanup-wrap">
  <div class="cleanup-header">
    <div><small>Talk2Me / Isolated UAT / Temporary until 31 October 2026</small><h1>Customer Cleanup & Approval Centre</h1>
      <p>Johnny processes the queue; Stephan and Gerda can review the same work.</p></div>
    <a class="btn" href="<%= basePath %>/backoffice/clients">Return to Customers</a>
  </div>
  <div class="cleanup-warning"><strong>UAT database only.</strong> Line and staff corrections take effect in UAT immediately and are audit-logged. A review approval does not delete any record. Consolidation archives only the specifically confirmed historical records; it never deletes them. Production is untouched.</div>
  <% if(saved){ %><div class="cleanup-note-box">Review saved with reviewer name and audit history. No customer values changed by this approval.</div><% } %>
  <% if(corrected){ %><div class="cleanup-note-box">Correction saved in UAT with an original-value snapshot and audit trail. Reload cases if the corrected phone or account changed its category.</div><% } %>
  <% const tabs=[['same_account_phone','Same cellphone / account'],['cross_account_phone','Different accounts'],['account_alias','Account aliases'],['staff_conflict','Staff conflicts'],['base_unlinked','Supplier lines without CRM link']]; %>
  <nav class="cleanup-nav" aria-label="Discrepancy categories">
    <% tabs.forEach(([k,label])=>{ %><a class="<%= type===k?'active':'' %>" href="<%= basePath %>/temporary-cleanup?type=<%= k %>"><%= label %></a><% }) %>
  </nav>
  <% if(selected){ %>
    <section class="cleanup-card">
      <h2><%= selected.display_name||'Customer record' %></h2>
      <p><strong>Account:</strong> <%= selected.display_account||'Unknown' %> &nbsp; <strong>Identifier:</strong> <%= selected.key %> &nbsp; <span class="cleanup-pill"><%= selected.record_count %> records</span></p>
      <p>Review status: <strong><%= selected.decision||'Not reviewed' %></strong><% if(selected.reviewer){ %> — last reviewed by <%= selected.reviewer %><% } %></p>
      <p class="cleanup-small">Compare each source record carefully. Different upgrade dates may reflect genuine previous contracts and must not be erased without evidence.</p>
      <div class="cleanup-grid">
        <% rows.forEach((r,i)=>{ %>
        <article class="cleanup-line">
          <header><strong>Record <%= i+1 %> / #<%= r.id %></strong>
            <% if(Object.prototype.hasOwnProperty.call(r,'is_active')){ %><span class="cleanup-pill"><%= r.is_active?'Active':'Archived/inactive' %></span><% } %>
          </header>
          <dl>
            <% Object.entries(r).filter(([k])=>!k.startsWith('_')).forEach(([k,v])=>{ %>
              <div><dt><%= k.replace(/_/g,' ') %></dt><dd><%= v==null?'—':v instanceof Date?v.toISOString().slice(0,19):String(v) %></dd></div>
            <% }) %>
          </dl>
          <% if(selected.type==='staff_conflict'){ %>
          <details class="cleanup-toggle">
            <summary>Correct staff member assigned to this record</summary>
            <form class="cleanup-form" method="post" action="<%= basePath %>/temporary-cleanup/staff/<%= encodeURIComponent(selected.key) %>/<%= r.id %>">
              <input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="assignment_hash" value="<%= r._assignmentHash %>">
              <label>Assign to verified staff member<select name="staff_id" required>
                <% staffOptions.forEach(st=>{ %><option value="<%= st.id %>" <%= Number(r.assigned_staff_id)===Number(st.id)?'selected':'' %>><%= st.full_name %></option><% }) %>
              </select></label>
              <label>Evidence / reason<textarea name="reason" minlength="12" maxlength="2000" required></textarea></label>
              <label class="cleanup-radio"><input type="checkbox" name="confirm_staff" value="1" required>I confirm this account's assigned staff member is correct.</label>
              <button type="submit" class="cleanup-btn">Save verified allocation in UAT</button>
            </form>
          </details>
          <% } %>
          <% if(selected.type==='same_account_phone'||selected.type==='cross_account_phone'){ %>
            <a href="<%= basePath %>/customers/<%= r.id %>/details" target="_blank" rel="noopener">Open existing CRM details</a>
            <details class="cleanup-toggle">
              <summary>Correct this line's details</summary>
              <form class="cleanup-form" method="post" action="<%= basePath %>/temporary-cleanup/correct/<%= encodeURIComponent(selected.type) %>/<%= encodeURIComponent(selected.key) %>/<%= r.id %>">
                <input type="hidden" name="csrf" value="<%= csrf %>">
                <input type="hidden" name="row_hash" value="<%= r._checkHash %>">
                <div class="fields">
                  <label>Customer name<input name="client_name" value="<%= r.client_name||'' %>" maxlength="255" required></label>
                  <label>Account number<input name="account_number" value="<%= r.account_number||'' %>" maxlength="80" required></label>
                  <label>Cellphone number<input name="cell_number" value="<%= r.cell_number||'' %>" maxlength="30" required></label>
                  <label>Email<input name="email" type="email" value="<%= r.email||'' %>" maxlength="180"></label>
                  <label>Previous upgrade date<input name="previous_upgrade_date" type="date" value="<%= r.previous_upgrade_date||'' %>"></label>
                  <label>Next upgrade date<input name="next_upgrade_date" type="date" value="<%= r.next_upgrade_date||'' %>"></label>
                  <label>Package<input name="package_name" value="<%= r.package_name||'' %>" maxlength="255"></label>
                  <label>Line status<select name="line_status"><% ['active','inactive','cancelled','suspended','unknown'].forEach(s=>{ %><option value="<%= s %>" <%= s===r.line_status?'selected':'' %>><%= s %></option><% }) %></select></label>
                </div>
                <div class="confirm">
                  <label><input type="checkbox" name="confirm_account_change" value="1">I confirm any account reassignment is correct and the destination account exists.</label>
                  <label><input type="checkbox" name="confirm_phone_change" value="1">I confirm any cellphone-number correction is verified.</label>
                  <label><input type="checkbox" name="confirm_change" value="1" required>I have checked the evidence; save these corrections to the UAT CRM.</label>
                </div>
                <label>Correction reason / supplier evidence<textarea name="reason" minlength="12" maxlength="2000" required placeholder="Explain the authoritative value, source and why it is correct."></textarea></label>
                <button class="cleanup-btn" type="submit">Save this line's corrections</button>
              </form>
            </details>
          <% } %>
        </article>
        <% }) %>
      </div>
    </section>
    <% if(selected.type==='same_account_phone'){ %>
    <section class="cleanup-card">
      <h3>Consolidate the current line (optional)</h3>
      <p>This is a separate, explicit operation. Select the one customer-line record that should remain current. Other active duplicate records will be <strong>archived, not deleted</strong>. Past contracts, tasks, messages and notes remain in their original records and audit history. The system will refuse consolidation if assignments or open tasks are unsafe.</p>
      <form class="cleanup-form" method="post" action="<%= basePath %>/temporary-cleanup/consolidate/<%= encodeURIComponent(selected.key) %>">
        <input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="snapshot" value="<%= selected.hash %>">
        <fieldset><legend><strong>Select the current record</strong></legend>
          <% rows.filter(r=>r.is_active).forEach(r=>{ %><label class="cleanup-radio">
            <input type="radio" name="primary_id" value="<%= r.id %>" required>
            #<%= r.id %> — <%= r.client_name||'No name' %>, next upgrade <%= r.next_upgrade_date||'not recorded' %>, package <%= r.package_name||'—' %>
          </label><% }) %>
        </fieldset>
        <label>Evidence and reason for archiving other duplicate records<textarea class="cleanup-note" name="reason" minlength="15" maxlength="2000" required placeholder="Explain why the selected line is the current active record, including source evidence."></textarea></label>
        <label class="cleanup-radio"><input type="checkbox" name="confirm_consolidate" value="1" required>
          I have checked the account, phone and history. Archive other active duplicates in UAT, not delete them.</label>
        <button type="submit" class="cleanup-btn danger">Confirm & apply safe consolidation in UAT</button>
      </form>
    </section>
    <% } %>
    <section class="cleanup-card">
      <h3>Record a review / approval</h3>
      <form method="post" action="<%= basePath %>/temporary-cleanup/review/<%= encodeURIComponent(selected.type) %>/<%= encodeURIComponent(selected.key) %>">
        <input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="snapshot" value="<%= selected.hash %>">
        <% const choices=[['approved_grouping','Approved account grouping (no customer records archived by this decision)'],['keep_separate','Keep records separate'],['needs_correction','Needs further correction'],['flagged','Flag for investigation']]; %>
        <% choices.forEach(([k,label])=>{if(k==='approved_grouping'&&selected.type!=='same_account_phone')return;%>
          <label class="cleanup-radio"><input type="radio" name="decision" value="<%= k %>" required <%= selected.decision===k?'checked':'' %>> <%= label %></label>
        <% }) %>
        <label class="cleanup-label">Reason and instructions<textarea class="cleanup-note" name="notes" minlength="8" maxlength="2000" required placeholder="Evidence reviewed, supplier information confirmed, decision explained"><%= selected.notes||'' %></textarea></label>
        <p><button type="submit" class="cleanup-btn secondary">Save approval / review</button> &nbsp;
          <a href="<%= basePath %>/temporary-cleanup?type=<%= type %>">Back to review queue</a></p>
      </form>
    </section>
  <% }else{ %>
  <section class="cleanup-card">
    <form class="cleanup-search" method="get" action="<%= basePath %>/temporary-cleanup">
      <input type="hidden" name="type" value="<%= type %>">
      <input name="q" value="<%= q %>" placeholder="Phone, customer or account" aria-label="Search cases">
      <select name="view"><option value="open" <%= view==='open'?'selected':'' %>>Outstanding / flagged</option>
        <option value="all" <%= view==='all'?'selected':'' %>>All, including approved</option></select>
      <button type="submit" class="cleanup-btn">Filter cases</button>
    </form>
    <p><strong><%= total %> cases</strong> in this view. Page <%= page %>.</p>
    <div class="cleanup-scroll">
      <table class="cleanup-table"><thead><tr><th>Customer</th><th>Account</th><th>Phone / key</th><th>Records</th><th>Differences</th><th>Review</th><th>Action</th></tr></thead>
        <tbody><% cases.forEach(c=>{ %><tr>
          <td><%= c.display_name||'Unknown' %></td><td><%= c.display_account||'—' %></td><td><%= c.case_key %></td><td><%= c.record_count %></td>
          <td><%= c.upgrade_variants>1?'Upgrade dates; ':'' %><%= c.name_variants>1?'Customer names; ':'' %></td>
          <td><span class="cleanup-pill"><%= c.decision||'Awaiting review' %></span><% if(c.reviewer){ %><div class="cleanup-small"><%= c.reviewer %></div><% } %></td>
          <td><a href="<%= basePath %>/temporary-cleanup/review/<%= type %>/<%= encodeURIComponent(c.case_key) %>">Review & correct</a></td>
        </tr><% }) %></tbody>
      </table>
      <% if(!cases.length){ %><p>No cases match this filter.</p><% } %>
    </div>
    <nav class="cleanup-pager" aria-label="Pagination">
      <% if(page>1){ %><a href="<%= basePath %>/temporary-cleanup?type=<%= type %>&view=<%= view %>&q=<%= encodeURIComponent(q) %>&page=<%= page-1 %>">← Previous</a><% } %>
      <% if(page*30<total){ %><a href="<%= basePath %>/temporary-cleanup?type=<%= type %>&view=<%= view %>&q=<%= encodeURIComponent(q) %>&page=<%= page+1 %>">Next →</a><% } %>
    </nav>
  </section>
  <% } %>
</section>
