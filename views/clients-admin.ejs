<link rel="stylesheet" href="<%= basePath %>/css/uat-customer-filters.css">
<section class="page-head">
  <div><h1>Customers</h1><p>Find clients and lines from the central database. Protected changes follow the approval workflow.</p></div>
  <% if(['owner','manager'].includes(currentUser.role)){ %>
    <a class="btn primary" href="<%= basePath %>/backoffice/clients/new">Add Client / Prospect</a>
  <% } else { %>
    <a class="btn primary" href="<%= basePath %>/queries/new">Quick Add / New Inquiry</a>
  <% } %>
</section>
<% if(['owner','manager'].includes(currentUser.role) || ['jonathan@talk-online.co.za','gerda@talk-online.co.za'].includes(String(currentUser.email||'').trim().toLowerCase())){ %>
  <div class="customer-duplicate-links" style="display:flex;flex-wrap:wrap;gap:9px;margin:10px 0 16px">
    <a class="btn small" href="<%= basePath %>/temporary-cleanup/triage?type=safe_line_group">Verified grouped lines</a>
    <a class="btn small" href="<%= basePath %>/temporary-cleanup/triage?type=manual_identity&amp;status=pending">Manual duplicate review</a>
  </div>
<% } %>
<% if(saved){ %><div class="success-box">Client assignment saved.</div><% } %>
<%
const staffScope=typeof staffVisibilityScope==='string'?staffVisibilityScope:'all';
const staffScopeSelectedId=Number(typeof staffVisibilitySelectedId!=='undefined'?staffVisibilitySelectedId:0)||null;
const managementVisibility=Boolean(typeof staffVisibilityManagement!=='undefined'?staffVisibilityManagement:false);
const selected=(value,expected)=>value===expected?'selected':'';
const staffFormValues=new URLSearchParams(queryStringFor({scope:'staff',staff_id:null,page:1}));
%>
<div class="card customer-visibility-card">
  <% if(managementVisibility){ %>
    <div><strong>Customer visibility</strong><small>View all customers, your own, or one staff member's customers.</small></div>
    <div class="customer-visibility-actions" role="group" aria-label="Customer visibility">
      <a class="btn small <%= staffScope==='all'?'primary':'' %>" href="<%= basePath %>/backoffice/clients?<%= queryStringFor({scope:'all',staff_id:null,page:1}) %>">All Staff</a>
      <a class="btn small <%= staffScope==='mine'?'primary':'' %>" href="<%= basePath %>/backoffice/clients?<%= queryStringFor({scope:'mine',staff_id:null,page:1}) %>">My Own</a>
      <form method="get" action="<%= basePath %>/backoffice/clients" class="customer-staff-picker">
        <% for(const [name,value] of staffFormValues.entries()){ %><input type="hidden" name="<%= name %>" value="<%= value %>"><% } %>
        <select name="staff_id" aria-label="Filter customers by staff member" onchange="if(this.value)this.form.submit()">
          <option value="">Choose staff member</option>
          <% staff.forEach(person=>{ %><option value="<%= person.id %>" <%= staffScope==='staff' && staffScopeSelectedId===Number(person.id)?'selected':'' %>><%= person.full_name %></option><% }) %>
        </select>
      </form>
    </div>
  <% }else{ %>
    <div><strong>Customer visibility</strong><small>All includes your customers and unassigned customers; My Own shows only customers assigned to you.</small></div>
    <div class="customer-visibility-actions" role="group" aria-label="Customer visibility">
      <a class="btn small <%= staffScope==='all'?'primary':'' %>" href="<%= basePath %>/backoffice/clients?<%= queryStringFor({scope:'all',staff_id:null,page:1}) %>">All</a>
      <a class="btn small <%= staffScope==='mine'?'primary':'' %>" href="<%= basePath %>/backoffice/clients?<%= queryStringFor({scope:'mine',staff_id:null,page:1}) %>">My Own</a>
    </div>
  <% } %>
</div>
<nav class="client-tabs" aria-label="Client views">
  <a class="<%= view==='all'?'active':'' %>" href="<%= basePath %>/backoffice/clients?<%= queryStringFor({view:'all',page:1}) %>">All active <span><%= counts.active_count||0 %></span></a>
  <a class="<%= view==='prospects'?'active':'' %>" href="<%= basePath %>/backoffice/clients?<%= queryStringFor({view:'prospects',page:1}) %>">Prospects <span><%= counts.prospect_count||0 %></span></a>
  <a class="<%= view==='incomplete'?'active':'' %>" href="<%= basePath %>/backoffice/clients?<%= queryStringFor({view:'incomplete',page:1}) %>">Incomplete <span><%= counts.incomplete_count||0 %></span></a>
  <a class="<%= view==='unassigned'?'active':'' %>" href="<%= basePath %>/backoffice/clients?<%= queryStringFor({view:'unassigned',page:1}) %>">Unassigned <span><%= counts.unassigned_count||0 %></span></a>
  <a class="<%= view==='archived'?'active':'' %>" href="<%= basePath %>/backoffice/clients?<%= queryStringFor({view:'archived',page:1}) %>">Archived <span><%= counts.archived_count||0 %></span></a>
</nav>
<section class="customer-attention-launcher" aria-label="Daily customer attention">
  <div class="customer-attention-intro">
    <strong>My day — customers to action</strong>
    <small>One click to see the customers who need a call, birthday follow-up, upgrade or allocation.</small>
  </div>
  <div class="customer-attention-actions">
    <a class="customer-attention-action <%= attention.focus==='needs_attention'&&staffScope==='mine'?'active':'' %>"
       href="<%= basePath %>/backoffice/clients?<%= queryStringFor({view:'all',scope:'mine',staff_id:null,focus:'needs_attention',q:null,upgrade_month:null,work:'all',date:'any',from:null,to:null,status:'all',sort:'recent',birthday:null,contact:null,unallocated:null,page:1}) %>">
      <strong>My Customers Needing Attention</strong><small>Overdue work and customer care</small>
    </a>
    <a class="customer-attention-action <%= attention.focus==='birthdays'?'active':'' %>"
       href="<%= basePath %>/backoffice/clients?<%= queryStringFor({view:'all',focus:'birthdays',birthday:'today',q:null,upgrade_month:null,work:'all',date:'any',from:null,to:null,status:'all',sort:'recent',contact:null,unallocated:null,page:1}) %>">
      <strong>Birthdays</strong><small>Today, this week and missed</small>
    </a>
    <a class="customer-attention-action <%= attention.focus==='contact'?'active':'' %>"
       href="<%= basePath %>/backoffice/clients?<%= queryStringFor({view:'all',focus:'contact',contact:'overdue',q:null,upgrade_month:null,work:'all',date:'any',from:null,to:null,status:'all',sort:'recent',birthday:null,unallocated:null,page:1}) %>">
      <strong>Follow-up Attention</strong><small>No recorded contact or overdue</small>
    </a>
    <a class="customer-attention-action <%= attention.focus==='unallocated'?'active':'' %>"
       href="<%= basePath %>/backoffice/clients?<%= queryStringFor({view:'all',scope:'all',staff_id:null,focus:'unallocated',unallocated:'customers',q:null,upgrade_month:null,work:'all',date:'any',from:null,to:null,status:'all',sort:'recent',birthday:null,contact:null,page:1}) %>">
      <strong>Unallocated</strong><small>Customers without an owner</small>
    </a>
  </div>
</section>
<section class="card customer-advanced-filter" id="customer-list-filter" aria-label="Customer list filters">
  <div class="customer-filter-heading">
    <div><strong>Find the customers and work you need</strong><small>Combine staff, upgrade month, work dates and status. Results update from the CRM.</small></div>
    <a class="btn small customer-clear-filters" href="<%= basePath %>/backoffice/clients?view=all&scope=all">Clear Filters</a>
  </div>
  <% if(filters.error){ %><div class="customer-filter-error" role="alert"><%= filters.error %></div><% } %>
  <form method="get" action="<%= basePath %>/backoffice/clients" id="customer-list-filter-form">
    <input type="hidden" name="view" value="<%= view %>">
    <input type="hidden" name="scope" value="<%= staffScope %>">
    <% if(staffScope==='staff' && staffScopeSelectedId){ %><input type="hidden" name="staff_id" value="<%= staffScopeSelectedId %>"><% } %>
    <div class="customer-filter-grid">
      <label>Customer attention
        <select name="focus" aria-label="Customer attention view">
          <option value="all" <%= selected(attention.focus,'all') %>>All customers / normal filters</option>
          <option value="needs_attention" <%= selected(attention.focus,'needs_attention') %>>Customers Needing Attention</option>
          <option value="birthdays" <%= selected(attention.focus,'birthdays') %>>Birthdays</option>
          <option value="contact" <%= selected(attention.focus,'contact') %>>Follow-up Attention</option>
          <option value="unallocated" <%= selected(attention.focus,'unallocated') %>>Unallocated Customers / Work</option>
        </select>
      </label>
      <label class="customer-attention-field" data-attention-when="birthdays" <%= attention.focus==='birthdays'?'':'hidden' %>>Birthday period
        <select name="birthday" aria-label="Birthday period">
          <option value="today" <%= selected(attention.birthday,'today') %>>Today</option>
          <option value="tomorrow" <%= selected(attention.birthday,'tomorrow') %>>Tomorrow</option>
          <option value="this_week" <%= selected(attention.birthday,'this_week') %>>This Week</option>
          <option value="this_month" <%= selected(attention.birthday,'this_month') %>>This Month</option>
          <option value="missed" <%= selected(attention.birthday,'missed') %>>Past 7 Days — Not Followed Up</option>
        </select>
      </label>
      <label class="customer-attention-field" data-attention-when="contact" <%= attention.focus==='contact'?'':'hidden' %>>Contact attention
        <select name="contact" aria-label="Contact attention">
          <option value="overdue" <%= selected(attention.contact,'overdue') %>>Overdue Follow-ups / Callbacks</option>
          <option value="no_record" <%= selected(attention.contact,'no_record') %>>No CRM Contact Recorded</option>
          <option value="no_recent" <%= selected(attention.contact,'no_recent') %>>No Follow-up Recorded in 30 Days</option>
        </select>
      </label>
      <label class="customer-attention-field" data-attention-when="unallocated" <%= attention.focus==='unallocated'?'':'hidden' %>>Unallocated view
        <select name="unallocated" aria-label="Unallocated customer or linked work">
          <option value="customers" <%= selected(attention.unallocated,'customers') %>>Customers Without an Owner</option>
          <option value="customer_work" <%= selected(attention.unallocated,'customer_work') %>>Unassigned Customers With Open Work</option>
        </select>
      </label>
      <label>Work type
        <select name="work" aria-label="Work type">
          <option value="all" <%= selected(filters.work,'all') %>>All Work / Customers</option>
          <option value="upgrades" <%= selected(filters.work,'upgrades') %>>Upgrades</option>
          <option value="tasks" <%= selected(filters.work,'tasks') %>>Tasks</option>
          <option value="followups" <%= selected(filters.work,'followups') %>>Follow-ups / Callbacks</option>
        </select>
      </label>
      <label>Upgrade month
        <input type="month" name="upgrade_month" value="<%= filters.month %>" aria-label="Upgrade month and year">
      </label>
      <label>Work date
        <select name="date" aria-label="Work date range">
          <option value="any" <%= selected(filters.date,'any') %>>Any date</option>
          <option value="today" <%= selected(filters.date,'today') %>>Today</option>
          <option value="this_week" <%= selected(filters.date,'this_week') %>>This Week</option>
          <option value="next_week" <%= selected(filters.date,'next_week') %>>Next Week</option>
          <option value="next_7" <%= selected(filters.date,'next_7') %>>Next 7 Days</option>
          <option value="next_14" <%= selected(filters.date,'next_14') %>>Next 14 Days</option>
          <option value="next_30" <%= selected(filters.date,'next_30') %>>Next 30 Days</option>
          <option value="custom" <%= selected(filters.date,'custom') %>>Custom Date Range</option>
        </select>
      </label>
      <label>Task status
        <select name="status" aria-label="Task or follow-up status">
          <option value="all" <%= selected(filters.status,'all') %>>All Statuses</option>
          <option value="outstanding" <%= selected(filters.status,'outstanding') %>>Outstanding</option>
          <option value="overdue" <%= selected(filters.status,'overdue') %>>Overdue</option>
          <option value="completed" <%= selected(filters.status,'completed') %>>Completed</option>
        </select>
      </label>
      <label>Sort results
        <select name="sort" aria-label="Sort customers">
          <option value="recent" <%= selected(filters.sort,'recent') %>>Latest Updated Customers</option>
          <option value="name_asc" <%= selected(filters.sort,'name_asc') %>>Name A–Z</option>
          <option value="name_desc" <%= selected(filters.sort,'name_desc') %>>Name Z–A</option>
          <option value="new_work" <%= selected(filters.sort,'new_work') %>>Newest Work</option>
          <option value="upgrade_soon" <%= selected(filters.sort,'upgrade_soon') %>>Upcoming Upgrade Dates</option>
        </select>
      </label>
      <label class="customer-date-custom">From
        <input type="date" name="from" value="<%= filters.from %>" aria-label="From date">
      </label>
      <label class="customer-date-custom">To
        <input type="date" name="to" value="<%= filters.to %>" aria-label="To date">
      </label>
    </div>
    <div class="customer-filter-search">
      <label for="customer-list-filter-input">Customer name, phone, email, account or ID</label>
      <div class="search-row">
        <input id="customer-list-filter-input" name="q" value="<%= q %>" autocomplete="off" placeholder="Search customers (three or more characters)">
        <button type="submit" class="primary">Show Results</button>
      </div>
      <small class="customer-list-filter-help">Only the Next Upgrade field determines upgrade eligibility. For Upgrades, status filters work recorded on those customers (tasks and follow-ups), not upgrade completion itself.</small>
    </div>
    <% if(attention.focus==='unallocated'&&staffScope!=='all'){ %>
      <div class="customer-filter-warning">Unallocated customers have no assigned staff member. Select All Staff (or All for ordinary staff) to see them.</div>
    <% } %>
    <% if(attention.focus!=='all'){ %><div class="customer-attention-explanation">
      <% if(attention.focus==='contact'){ %>Contact evidence is based on completed CRM follow-ups, callbacks and documented inquiry actions. Desktop WhatsApp or calls not recorded in CRM cannot be detected.<% } %>
      <% if(attention.focus==='birthdays'){ %>Missed birthdays are from the previous 7 days with no completed CRM contact or Gerda birthday check recorded after the birthday.<% } %>
      <% if(attention.focus==='unallocated'){ %>The customer has no owner. Tasks and follow-ups themselves require a named assignee; linked work is shown separately and is not labelled unassigned.<% } %>
      <% if(attention.focus==='needs_attention'){ %>Includes overdue upgrades, overdue tasks, callbacks, follow-ups, open inquiries, recent birthdays with no recorded follow-up and customers without an owner.<% } %>
    </div><% } %>
  </form>
</section>
<div class="customer-results-summary" role="status" aria-live="polite">
  <strong><%= total.toLocaleString('en-ZA') %> matching customer<%= total===1?'':'s' %></strong>
  <span><% if(total){ %>Showing <%= firstRecord %>–<%= lastRecord %> of <%= total %><% }else{ %>Try a different date, staff member or filter.<% } %></span>
</div>
<div class="card table-card customer-results-card">
  <table class="data-table customer-admin-table">
    <thead><tr><th>Client and account</th><th>Type</th><th>Contact</th><th>Latest inquiry</th><th>Town</th><th>Next Upgrade</th><% if(attention.focus==='birthdays'){ %><th>Birthday</th><% } %><% if(attention.focus!=='all'){ %><th>Attention needed</th><% } %><th>Assigned staff</th><th aria-label="Edit"></th></tr></thead>
    <tbody>
    <% if(!clients.length){ %><tr class="customer-empty-row"><td colspan="<%= 8+(attention.focus==='birthdays'?1:0)+(attention.focus!=='all'?1:0) %>">No customers match the selected filters.</td></tr><% } %>
    <% clients.forEach(c=>{ %><tr>
      <td data-label="Customer"><a class="customer-name-link" href="<%= basePath %>/customers/<%= c.id %>/360"><strong><%= c.client_name %></strong><% if(c.account_number){ %><small>Account: <%= c.account_number %></small><% } %><% if(c.email){ %><small><%= c.email %></small><% } %></a></td>
      <td data-label="Type"><span class="client-status <%= c.lifecycle_status||'client' %>"><%= c.lifecycle_status||'client' %></span><% if(c.lead_status){ %><br><small><%= c.lead_status.replace('_',' ') %></small><% } %></td>
      <td data-label="Contact"><%= c.cell_number||'—' %></td>
      <td data-label="Latest inquiry"><%= c.last_inquiry||'—' %><% if(c.last_action){ %><br><small><strong>Action:</strong> <%= c.last_action %></small><% } %></td>
      <td data-label="Town"><%= c.city_town||'—' %></td>
      <td data-label="Next Upgrade"><strong><%= c.next_upgrade_date?new Date(c.next_upgrade_date).toLocaleDateString('en-ZA'):'—' %></strong><% if(c.previous_upgrade_date){ %><br><small>Previous: <%= new Date(c.previous_upgrade_date).toLocaleDateString('en-ZA') %></small><% } %></td>
      <% if(attention.focus==='birthdays'){ %><td data-label="Birthday"><strong><%= c.birthday?new Date(c.birthday).toLocaleDateString('en-ZA',{day:'2-digit',month:'short',timeZone:'Africa/Johannesburg'}):'—' %></strong></td><% } %>
      <% if(attention.focus!=='all'){ %><td data-label="Attention needed"><div class="customer-attention-badges"><% (c.attentionReasons||[]).forEach(reason=>{ %><span class="customer-attention-badge"><%= reason %></span><% }) %></div></td><% } %>
      <td data-label="Assigned staff">
        <% if(['owner','manager'].includes(currentUser.role)){ %>
          <form method="post" action="<%= basePath %>/backoffice/clients/<%= c.id %>/assign" class="assignment-form compact-assignment-form" data-assignment-form>
            <input type="hidden" name="return_q" value="<%= q %>">
            <input type="hidden" name="return_view" value="<%= view %>">
            <input type="hidden" name="return_scope" value="<%= staffScope %>">
            <% if(staffScopeSelectedId){ %><input type="hidden" name="return_staff_id" value="<%= staffScopeSelectedId %>"><% } %>
            <input type="hidden" name="return_filters" value="<%= queryStringFor({page:page}) %>">
            <select name="assigned_staff_id" aria-label="Assigned staff for <%= c.client_name %>" data-original-value="<%= c.assigned_staff_id||'' %>">
              <option value="">Unassigned</option>
              <% staff.forEach(s=>{ %><option value="<%= s.id %>" <%= Number(c.assigned_staff_id)===Number(s.id)?'selected':'' %>><%= s.full_name %></option><% }) %>
            </select>
            <button class="assignment-save-button" type="submit" aria-label="Save assignment" title="Save assignment" disabled>✓</button>
          </form>
        <% }else{ %><span><%= c.assigned_staff_name||'Unassigned' %></span><% } %>
      </td>
      <td class="customer-row-edit" data-label="Edit"><% if(['owner','manager'].includes(currentUser.role)){ %><a class="customer-edit-icon" href="<%= basePath %>/backoffice/clients/<%= c.id %>/edit" aria-label="Edit <%= c.client_name %>" title="Edit line">✎</a><% } %></td>
    </tr><% }) %>
    </tbody>
  </table>
</div>
<% if(pageCount>1){ %>
<nav class="customer-pagination" aria-label="Customer pages">
  <% if(page>1){ %><a class="btn small" href="<%= basePath %>/backoffice/clients?<%= queryStringFor({page:page-1}) %>">← Previous</a><% } %>
  <span>Page <%= page %> of <%= pageCount %></span>
  <% if(page<pageCount){ %><a class="btn small" href="<%= basePath %>/backoffice/clients?<%= queryStringFor({page:page+1}) %>">Next →</a><% } %>
</nav>
<% } %>
<script>
(()=>{
  const form=document.getElementById('customer-list-filter-form');
  const input=document.getElementById('customer-list-filter-input');
  const dateSelect=form?.querySelector('[name="date"]');
  const workSelect=form?.querySelector('[name="work"]');
  const focusSelect=form?.querySelector('[name="focus"]');
  const statusSelect=form?.querySelector('[name="status"]');
  const from=form?.querySelector('[name="from"]');
  const to=form?.querySelector('[name="to"]');
  if(form){
    const sync=()=>{
      const custom=dateSelect?.value==='custom';
      form.querySelectorAll('.customer-date-custom').forEach(node=>node.hidden=!custom);
      form.querySelectorAll('.customer-attention-field').forEach(node=>node.hidden=node.dataset.attentionWhen!==focusSelect?.value);
      if(from)from.required=custom;
      if(to)to.required=custom;
      // Status remains available for tasks and follow-ups linked to upgrade lines.
      if(statusSelect)statusSelect.disabled=false;
    };
    sync();
    form.querySelectorAll('select').forEach(select=>select.addEventListener('change',()=>{
      sync();
      if(dateSelect?.value==='custom'&&(!from?.value||!to?.value))return;
      form.requestSubmit();
    }));
    form.querySelector('[name="upgrade_month"]')?.addEventListener('change',()=>form.requestSubmit());
    form.querySelectorAll('.customer-date-custom input').forEach(el=>el.addEventListener('change',()=>{
      if(dateSelect?.value==='custom'&&from?.value&&to?.value)form.requestSubmit();
    }));
    if(input){
      let timer;
      input.addEventListener('input',()=>{
        clearTimeout(timer);const q=input.value.trim();
        if(q.length>0&&q.length<3)return;
        timer=setTimeout(()=>form.requestSubmit(),400);
      });
    }
  }
  document.querySelectorAll('[data-assignment-form]').forEach(assignmentForm=>{
    const select=assignmentForm.querySelector('select');
    const button=assignmentForm.querySelector('.assignment-save-button');
    if(!select||!button)return;
    const sync=()=>{
      const changed=String(select.value)!==String(select.dataset.originalValue||'');
      button.disabled=!changed;button.classList.toggle('is-ready',changed);
    };
    select.addEventListener('change',sync);sync();
  });
})();
</script>
