<section class="page-head">
  <div>
    <div class="eyebrow">Owner only</div>
    <h1>Contact Lists & Customer Communication</h1>
    <p>Build a customer audience by category and date, copy or export contact details, and send an authenticated Talk2Me email to the selected list.</p>
  </div>
  <a class="btn" href="<%= basePath %>/backoffice">Back to Administration</a>
</section>

<% if(message){ %><div class="panel" style="border-left:4px solid #15803d;margin-bottom:16px"><strong><%= message %></strong></div><% } %>
<% if(error){ %><div class="panel" style="border-left:4px solid #b42318;margin-bottom:16px"><strong><%= error %></strong></div><% } %>

<section class="panel">
  <div class="panel-heading-row"><div><h2>1. Build the audience</h2><p class="muted">The date meaning changes automatically to match the selected category.</p></div></div>
  <form method="get" action="<%= basePath %>/backoffice/contact-lists" class="form-grid" id="audience-filter-form">
    <label>Customer category
      <select name="category">
        <% Object.entries(categories).forEach(([value,label])=>{ %>
          <option value="<%= value %>" <%= filters.category===value?'selected':'' %>><%= label %></option>
        <% }) %>
      </select>
    </label>
    <label>Date range
      <select name="preset" id="contact-preset">
        <option value="all" <%= filters.preset==='all'?'selected':'' %>>All time</option>
        <option value="today" <%= filters.preset==='today'?'selected':'' %>>Today</option>
        <option value="7d" <%= filters.preset==='7d'?'selected':'' %>>Last 7 days</option>
        <option value="30d" <%= filters.preset==='30d'?'selected':'' %>>Last 30 days</option>
        <option value="3m" <%= filters.preset==='3m'?'selected':'' %>>Last 3 months</option>
        <option value="6m" <%= filters.preset==='6m'?'selected':'' %>>Last 6 months</option>
        <option value="12m" <%= filters.preset==='12m'?'selected':'' %>>Last 12 months</option>
        <option value="custom" <%= filters.preset==='custom'?'selected':'' %>>Custom dates</option>
      </select>
    </label>
    <label class="custom-date">From
      <input type="date" name="from" value="<%= filters.from||'' %>">
    </label>
    <label class="custom-date">To
      <input type="date" name="to" value="<%= filters.to||'' %>">
    </label>
    <div style="display:flex;align-items:end"><button class="btn primary" type="submit">Build List</button></div>
  </form>
  <p class="muted" style="margin-top:12px"><strong>Date applies to:</strong> <%= audience.dateBasis %> · <strong>Selected period:</strong> <%= audience.range.label %></p>
</section>

<section class="command-stats" style="margin-top:16px">
  <div><span>Contacts found</span><strong><%= audience.counts.contacts %></strong></div>
  <div><span>Unique valid emails</span><strong><%= audience.counts.emails %></strong></div>
  <div><span>Unique SA mobile numbers</span><strong><%= audience.counts.mobiles %></strong></div>
</section>

<section class="panel" style="margin-top:16px">
  <div class="panel-heading-row">
    <div><h2>2. Use the list</h2><p class="muted"><%= audience.categoryLabel %> · <%= audience.range.label %></p></div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn" type="button" id="copy-emails">Copy Emails</button>
      <button class="btn" type="button" id="copy-mobiles">Copy Mobile Numbers</button>
      <a class="btn" href="<%= basePath %>/backoffice/contact-lists/export.csv?category=<%= encodeURIComponent(filters.category) %>&preset=<%= encodeURIComponent(filters.preset) %>&from=<%= encodeURIComponent(filters.from||'') %>&to=<%= encodeURIComponent(filters.to||'') %>">Export CSV</a>
    </div>
  </div>
  <div id="copy-status" class="muted" aria-live="polite"></div>
  <div style="overflow:auto;margin-top:12px;max-height:460px">
    <table class="data-table">
      <thead><tr><th>Name</th><th>Email</th><th>Mobile</th><th>Account</th><th>Category</th><th>Package</th><th>Date</th></tr></thead>
      <tbody>
        <% audience.contacts.slice(0,500).forEach(row=>{ %>
          <tr>
            <td><%= row.contact_name||'—' %></td>
            <td><%= row.email||'—' %></td>
            <td><%= row.mobile_number||'—' %></td>
            <td><%= row.account_number||'—' %></td>
            <td><%= row.category_label||'—' %></td>
            <td><%= row.package_name||'—' %></td>
            <td><%= row.contact_date ? new Date(row.contact_date).toLocaleDateString('en-ZA') : '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if(audience.contacts.length>500){ %><p class="muted">Showing the first 500 contacts on screen. The CSV export contains the full filtered list.</p><% } %>
</section>

<section class="panel" style="margin-top:16px">
  <div class="panel-heading-row"><div><h2>3. Send Email to This List</h2><p class="muted">Write a new message or import an existing company email. Talk2Me sends a new authenticated email to each recipient individually.</p></div></div>

  <div class="panel" style="background:#f8fafc;margin:12px 0 18px">
    <h3 style="margin-top:0">Email content</h3>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px">
      <div>
        <strong>Write manually</strong>
        <p class="muted" style="margin:5px 0 0">Use the Subject and Message fields below.</p>
      </div>
      <div>
        <strong>Import existing email</strong>
        <p class="muted" style="margin:5px 0 8px">Upload an Outlook/other email saved as <strong>.eml</strong>, or an <strong>.html/.htm</strong> campaign file. Talk2Me imports and sanitises the content before sending.</p>
        <form method="post" enctype="multipart/form-data" action="<%= basePath %>/backoffice/contact-lists/import-email">
          <input type="hidden" name="category" value="<%= filters.category %>">
          <input type="hidden" name="preset" value="<%= filters.preset %>">
          <input type="hidden" name="from" value="<%= filters.from||'' %>">
          <input type="hidden" name="to" value="<%= filters.to||'' %>">
          <input type="file" name="email_file" accept=".eml,.html,.htm,message/rfc822,text/html" required>
          <button class="btn" type="submit" style="margin-top:8px">Import Email</button>
        </form>
      </div>
    </div>
  </div>

  <% if(importedEmail){ %>
    <div class="panel" style="border-left:4px solid #2563eb;margin-bottom:18px">
      <div class="panel-heading-row">
        <div>
          <div class="eyebrow">Imported email ready</div>
          <h3 style="margin:4px 0"><%= importedEmail.subject || 'No original subject' %></h3>
          <p class="muted" style="margin:4px 0">File: <%= importedEmail.sourceFilename %><% if(importedEmail.originalFrom){ %> · Original sender: <%= importedEmail.originalFrom %><% } %></p>
          <p class="muted" style="margin:4px 0"><%= importedEmail.attachments.length %> attachment<%= importedEmail.attachments.length===1?'':'s' %><% if(importedEmail.inlineImageCount){ %> · <%= importedEmail.inlineImageCount %> inline image<%= importedEmail.inlineImageCount===1?'':'s' %><% } %></p>
        </div>
        <form method="post" action="<%= basePath %>/backoffice/contact-lists/clear-import">
          <input type="hidden" name="category" value="<%= filters.category %>">
          <input type="hidden" name="preset" value="<%= filters.preset %>">
          <input type="hidden" name="from" value="<%= filters.from||'' %>">
          <input type="hidden" name="to" value="<%= filters.to||'' %>">
          <button class="btn" type="submit">Clear Import</button>
        </form>
      </div>
      <div style="margin-top:12px">
        <strong>Preview</strong>
        <iframe id="imported-email-preview" sandbox="" title="Imported email preview" style="display:block;width:100%;min-height:420px;border:1px solid #d0d5dd;border-radius:10px;background:white;margin-top:8px"></iframe>
      </div>
    </div>
  <% } %>

  <form method="post" id="campaign-form">
    <input type="hidden" name="category" value="<%= filters.category %>">
    <input type="hidden" name="preset" value="<%= filters.preset %>">
    <input type="hidden" name="from" value="<%= filters.from||'' %>">
    <input type="hidden" name="to" value="<%= filters.to||'' %>">
    <div style="display:flex;gap:18px;flex-wrap:wrap;margin-bottom:14px">
      <label style="display:flex;gap:7px;align-items:center"><input type="radio" name="email_mode" value="manual" style="width:auto" <%= !importedEmail || campaign?.mode==='manual' ? 'checked' : '' %>> Write manually</label>
      <label style="display:flex;gap:7px;align-items:center"><input type="radio" name="email_mode" value="imported" style="width:auto" <%= importedEmail && campaign?.mode!=='manual' ? 'checked' : '' %> <%= importedEmail?'':'disabled' %>> Use imported email</label>
    </div>
    <label>Subject
      <input type="text" name="subject" maxlength="180" required value="<%= campaign?.subject || importedEmail?.subject || '' %>" placeholder="Email subject">
    </label>
    <label style="display:block;margin-top:12px">Message
      <textarea name="body" rows="10" placeholder="Write the customer email here"><%= campaign?.body || '' %></textarea>
    </label>
    <% if(importedEmail){ %><p class="muted" style="margin-top:7px">When <strong>Use imported email</strong> is selected, the previewed HTML email is sent. You can still change the Subject above.</p><% } %>
    <div class="panel" style="margin-top:14px;background:#f8fafc">
      <strong>Authenticated sender: Talk2Me CRM</strong>
      <p class="muted" style="margin:6px 0 10px">The imported company's original From/To/CC headers are not reused. Talk2Me creates a new outgoing message through its configured SMTP sender.</p>
      <strong>Audience ready: <%= audience.counts.emails %> valid unique email address<%= audience.counts.emails===1?'':'es' %></strong>
      <p class="muted" style="margin:6px 0 0">For the owner-only pilot, direct campaign sending is limited to 250 recipients per send. Larger lists can still be copied or exported while we validate the workflow.</p>
    </div>
    <label style="display:flex;gap:8px;align-items:flex-start;margin-top:14px">
      <input type="checkbox" name="confirm_send" value="1" style="width:auto;margin-top:4px">
      <span>I confirm that I want to send this message to the <strong><%= audience.counts.emails %></strong> selected email recipients.</span>
    </label>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px">
      <button class="btn" type="submit" formaction="<%= basePath %>/backoffice/contact-lists/test-email">Send Test to My Owner Email</button>
      <button class="btn primary" type="submit" formaction="<%= basePath %>/backoffice/contact-lists/send-email" <%= audience.counts.emails===0?'disabled':'' %>>Send Email to This List</button>
    </div>
  </form>
</section>

<script>
(() => {
  const preset = document.getElementById('contact-preset');
  const custom = [...document.querySelectorAll('.custom-date')];
  const updateCustom = () => custom.forEach(el => { el.style.display = preset.value === 'custom' ? '' : 'none'; });
  preset.addEventListener('change', updateCustom);
  updateCustom();

  const emails = <%- JSON.stringify(audience.emails) %>;
  const mobiles = <%- JSON.stringify(audience.mobiles) %>;
  const status = document.getElementById('copy-status');
  async function copy(values, label) {
    if (!values.length) { status.textContent = `No ${label} available in this audience.`; return; }
    try {
      await navigator.clipboard.writeText(values.join('\n'));
      status.textContent = `${values.length} ${label} copied.`;
    } catch {
      const area = document.createElement('textarea');
      area.value = values.join('\n');
      document.body.appendChild(area); area.select(); document.execCommand('copy'); area.remove();
      status.textContent = `${values.length} ${label} copied.`;
    }
  }
  document.getElementById('copy-emails').addEventListener('click', () => copy(emails, 'email addresses'));
  document.getElementById('copy-mobiles').addEventListener('click', () => copy(mobiles, 'mobile numbers'));

  <% if(importedEmail){ %>
  const preview = document.getElementById('imported-email-preview');
  if (preview) preview.srcdoc = <%- JSON.stringify(importedEmail.html).replace(/</g, '\\u003c') %>;
  <% } %>
})();
</script>
