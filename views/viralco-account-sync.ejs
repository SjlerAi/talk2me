<link rel="stylesheet" href="<%= basePath %>/public/css/viralco-sync.css?v=<%= encodeURIComponent(assetVersion||appVersion) %>">
<section class="page-head viralco-page-head">
  <div>
    <a class="vc-back" href="<%= basePath %>/customers/<%= client.id %>/360">← Return to Customer 360</a>
    <h1>Update Business Account from ViralCo</h1>
    <p><strong><%= account.display_name||client.client_name %></strong> · Official CRM account <strong><%= account.account_number %></strong></p>
    <p>Import the original Subscriber Detailed Report. Do not manually rebuild the spreadsheet.</p>
  </div>
</section>
<% if(message){ %><div class="success-box" role="status"><%= message %></div><% } %>
<% if(error){ %><div class="warning-box" role="alert"><%= error %></div><% } %>
<div class="vc-summary">
  <article><small>Last ViralCo update</small><strong><%= current?new Date(current.published_at).toLocaleDateString('en-ZA'):'Not yet imported' %></strong><span><%= current?(Date.now()-new Date(current.published_at).getTime()>90*86400000?'Update due (over 90 days)':'Up to date — version '+current.version_no):'Update due — first import required' %></span></article>
  <article><small>Current provider lines</small><strong><%= current?current.line_count:0 %></strong><span>Structured and searchable by line</span></article>
  <article><small>Pending manual review</small><strong><%= current?current.review_count:0 %></strong><span>Only safe matches update automatically</span></article>
</div>
<% if(manager&&typeof managerRequests!=='undefined'&&managerRequests&&managerRequests.length){ %>
<section class="panel vc-manager-queue">
  <h2>Referred to Manager — Upload Reviews</h2>
  <p>These decisions were referred by staff. Open the original preview and resolve its numbered conflict. The employee can then finish the upload.</p>
  <div class="vc-manager-queue-items">
    <% managerRequests.forEach(item=>{ %>
      <a href="<%= basePath %>/customers/<%= client.id %>/viralco-sync?preview=<%= item.preview_id %>#review-issue-<%= item.issue_number %>">
        <strong>Conflict <%= item.issue_number %> — <%= item.issue_type.replace(/_/g,' ') %></strong>
        <small>MSISDN <%= item.phone_normalised?'0'+item.phone_normalised.slice(2):'Account identity' %> · Uploaded by staff #<%= item.uploaded_by %> · <%= item.filename %></small>
        <span>Open Review <span aria-hidden="true">→</span></span>
      </a>
    <% }) %>
  </div>
</section>
<% } %>
<section class="panel vc-panel">
  <div class="vc-panel-top"><div>
    <h2>Step 1 — Upload the original ViralCo report</h2>
    <p>In ViralCo, open this business account and export <strong>Subscriber Detailed Report</strong> with both <strong>Eligible for Upgrade = All</strong> and <strong>Dealer ID = All</strong>.</p>
  </div></div>
  <form method="post" action="<%= basePath %>/customers/<%= client.id %>/viralco-sync/upload" enctype="multipart/form-data" class="vc-upload-form">
    <input type="hidden" name="viralco_csrf" value="<%= csrfToken %>">
    <label for="viralco-report-file">Original ViralCo Excel (.xlsx)</label>
    <input id="viralco-report-file" type="file" name="report" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required>
    <button type="submit" class="btn primary">Upload & Preview Changes</button>
  </form>
  <small class="vc-hint">The importer identifies the account using ViralCo's Account Number and matches lines by normalised MSISDN. Previous customer notes, ownership, invoices, upgrades and activity history are protected.</small>
</section>
<% if(preview){ %>
<section class="panel vc-preview" id="viralco-preview">
  <span class="vc-eyebrow">Review before publishing</span>
  <h2>Step 2 — Confirm the account and changes</h2>
  <div class="vc-identity">
    <div><small>CRM account number</small><strong><%= account.account_number %></strong><small><%= account.display_name||'Account name unavailable' %></small></div>
    <div><small>ViralCo account number</small><strong><%= preview.report.accountNumber %></strong><small><%= preview.report.customerName %></small></div>
  </div>
  <% if(!preview.accountMatches){ %><div class="warning-box">The account numbers do not match. The system will not import this file here.</div><% } %>
  <% if(preview.nameMismatch){ %>
  <div class="warning-box"><strong>Company name conflict.</strong> The CRM account name differs from ViralCo's business name. This does not necessarily mean the account number is wrong. Management must verify the company identity before any update is published.</div>
  <% if(!preview.canConfirmName){ %><p><strong>Ask Gerda or a manager to confirm this report for the correct business account.</strong> You can inspect the results but cannot publish a mismatched company name.</p><% } %>
  <% } %>
  <% if(preview.baselineChanged||preview.versionChanged){ %><div class="warning-box">The CRM changed since this workbook was uploaded. Re-upload to see an up-to-date comparison before publishing.</div><% } %>
  <div class="vc-stat-grid">
    <div><strong><%= preview.total %></strong><small>ViralCo subscriber lines</small></div>
    <div><strong><%= preview.matched %></strong><small>Matched to this CRM account</small></div>
    <div><strong><%= preview.changed %></strong><small>Existing lines with changed details</small></div>
    <div><strong><%= preview.unchanged %></strong><small>Existing lines unchanged</small></div>
    <div><strong><%= preview.safeNew %></strong><small>New numbers without existing CRM records</small></div>
    <div><strong><%= preview.conflicts %></strong><small>Ownership / duplicate conflicts</small></div>
    <div><strong><%= preview.missingCount %></strong><small>CRM lines absent from this report</small></div>
    <div><strong><%= preview.eligible %></strong><small>ViralCo lines marked Upgradable = Y</small></div>
  </div>
  <% if(preview.missingCount){ %><div class="vc-review-note"><strong><%= preview.missingCount %> CRM lines are not listed in the new report.</strong> They will NOT be archived, deleted, cancelled or unassigned automatically.</div><% } %>
  <% if(preview.mismatchEligibility){ %><div class="vc-review-note"><%= preview.mismatchEligibility %> ViralCo lines are marked N even though their Earliest Update Date is in the past. The importer preserves both fields separately instead of assuming that the date alone proves eligibility.</div><% } %>
  <div class="vc-review-workflow" id="viralco-review-summary">
    <div class="vc-review-workflow-heading">
      <div><h3>Numbered conflicts and review items</h3>
        <p>The issue number (1, 2, 3) is a checklist number. <strong>MSISDN is the mobile number</strong>; Excel row is a separate reference.</p></div>
      <div class="vc-review-status"><strong><%= preview.review.unresolved %></strong> unresolved ·
        <strong><%= preview.review.held+preview.review.referred %></strong> held/referred ·
        <strong><%= preview.review.resolved %></strong> resolved</div>
    </div>
    <% if(!preview.issues.length){ %>
      <div class="success-box">No identity, duplicate, missing or new-number conflicts were found. Unique matches can use the safe provider updates shown below.</div>
    <% } %>
    <% preview.issues.forEach(issue=>{ const decision=issue.decision; %>
      <article class="vc-issue" id="review-issue-<%= issue.number %>">
        <div class="vc-issue-top">
          <div><strong>Conflict <%= issue.number %> — <%= issue.label %></strong>
            <div class="vc-issue-meta">
              <span>MSISDN: <b><%= issue.phone?'0'+issue.phone.slice(2):'Account-level issue' %></b></span>
              <% if(issue.sourceRow){ %><span>Excel row: <b><%= issue.sourceRow %></b></span><% } %>
              <% if(issue.clientId){ %><span>CRM ID: <b><%= issue.clientId %></b></span><% } %>
            </div>
          </div>
          <span class="vc-issue-state <%= decision?'vc-state-'+decision.status:'vc-state-unresolved' %>"><%= decision?decision.status.toUpperCase():'UNRESOLVED' %></span>
        </div>
        <p class="vc-issue-reason"><%= issue.reason %></p>
        <% if(issue.type==='account_name'){ %>
          <div class="vc-issue-comparison"><div><small>Existing CRM company</small><strong><%= issue.crmName||'Unknown' %></strong></div>
            <div><small>ViralCo company</small><strong><%= issue.viralcoValue %></strong></div></div>
        <% }else{ %>
          <div class="vc-issue-comparison">
            <div><small>Existing CRM records</small>
              <% if(issue.crmMatches&&issue.crmMatches.length){issue.crmMatches.forEach(record=>{ %>
                <strong><%= record.clientName||'CRM record' %> — #<%= record.id %></strong>
                <small>Account <%= record.accountNumber||'Not allocated' %>
                  <% if(record.id){ %> · <a href="<%= basePath %>/customers/<%= record.id %>/360">Inspect CRM line</a><% } %></small>
              <% })}else{ %><strong>None found</strong><% } %>
            </div>
            <div><small>ViralCo / existing value</small><strong><%= issue.viralcoValue||issue.crmValue||issue.subscriber||'Not listed by ViralCo' %></strong></div>
          </div>
        <% } %>
        <form class="vc-issue-decision-form" method="post" action="<%= basePath %>/customers/<%= client.id %>/viralco-sync/decision">
          <input type="hidden" name="viralco_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="preview_id" value="<%= preview.id %>">
          <input type="hidden" name="issue_key" value="<%= issue.key %>">
          <label>What should we do?
            <select name="choice" required>
              <option value="" <%= !decision?'selected':'' %>>Select a decision</option>
              <% issue.choices.forEach(choice=>{
                if(['verify_account'].includes(choice)&&!manager)return;
                if(['create_line','rename_account'].includes(choice)&&!ownerManager)return;
                const captions={
                  verify_account:'Verify same business (keep CRM name)',
                  rename_account:'Approve business name correction',
                  create_line:'Create new line on this account',
                  keep_crm:'Keep current CRM / no change',
                  hold:'Hold and investigate (exclude from update)',
                  refer_manager:'Send to manager (exclude from update)'
                };
              %><option value="<%= choice %>" <%= decision&&decision.choice===choice?'selected':'' %>><%= captions[choice]||choice %></option><% }) %>
            </select>
          </label>
          <label>Explanation / investigation notes
            <textarea name="note" maxlength="900" rows="2" placeholder="Why is this decision correct?"><%= decision?.note||'' %></textarea>
          </label>
          <button type="submit" class="btn" <%= (preview.baselineChanged||preview.versionChanged)?'disabled':'' %>>Save Decision — Conflict <%= issue.number %></button>
        </form>
        <% if(decision){ %><small class="vc-decision-note">Saved: <%= decision.choice.replace(/_/g,' ') %> · <%= decision.note||'No note' %></small><% } %>
      </article>
    <% }) %>
    <p class="vc-review-summary-line">
      <% if(preview.review.ready){ %><strong>Ready:</strong> Every required conflict has a saved decision. Held and referred numbers will be excluded.<% }
      else { %><strong>Not ready:</strong> Resolve each numbered item, or deliberately hold/refer it with an explanation. A company-name mismatch must be approved by management.<% } %>
    </p>
  </div>
  <div class="vc-table-scroll" id="viralco-data-changes">
    <table class="data-table vc-table">
      <thead><tr><th>MSISDN</th><th>Subscriber</th><th>Package</th><th>Earliest eligible date</th><th>ViralCo eligible?</th><th>Avg spend</th><th>CRM action</th></tr></thead>
      <tbody><% preview.rows.slice(0,60).forEach(line=>{ %>
        <tr><td><%= '0'+line.phone.slice(2) %></td><td><%= line.subscriberName||'—' %></td><td><%= line.packDesc %></td><td><%= line.earliestUpgradeDate||'—' %></td>
          <td><span class="vc-chip <%= line.upgradable==='Y'?'vc-chip-yes':'' %>"><%= line.upgradable==='Y'?'Yes':'No' %></span></td>
          <td><%= line.avgSpend===null?'—':'R '+Number(line.avgSpend).toFixed(2) %></td>
          <td><span class="vc-chip"><%= ({update:'Update line',unchanged:'Unchanged',new:'New — review',conflict:'Ownership conflict',ambiguous:'Duplicate CRM identity'})[line.action]||line.action %></span>
            <% if(line.reason){ %><small class="vc-row-warning"><%= line.reason %></small><% } %>
            <% if(line.action==='update'){ %>
              <form method="post" action="<%= basePath %>/customers/<%= client.id %>/viralco-sync/decision" class="vc-data-choice">
                <input type="hidden" name="viralco_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="preview_id" value="<%= preview.id %>">
                <input type="hidden" name="issue_key" value="change-<%= line.sourceRow %>">
                <select name="choice" aria-label="Choose update for Excel row <%= line.sourceRow %>">
                  <option value="use_viralco" <%= !line.changeDecision||line.changeDecision.choice==='use_viralco'?'selected':'' %>>Use ViralCo data</option>
                  <option value="keep_crm" <%= line.changeDecision&&line.changeDecision.choice==='keep_crm'?'selected':'' %>>Keep existing CRM values</option>
                </select>
                <input type="hidden" name="note" value="">
                <button type="submit" class="btn">Save</button>
              </form>
              <small>Excel row <%= line.sourceRow %>. Current package: <%= line.previous?.package_name||'—' %> → ViralCo: <%= line.packDesc %></small>
            <% } %>
          </td>
        </tr>
      <% }) %></tbody>
    </table>
  </div>
  <% if(preview.rows.length>60){ %><small>Showing 60 of <%= preview.rows.length %> rows. All rows are processed on confirmation.</small><% } %>
  <form class="vc-confirm-form" method="post" action="<%= basePath %>/customers/<%= client.id %>/viralco-sync/publish">
    <input type="hidden" name="viralco_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="preview_id" value="<%= preview.id %>">
    <p>Each new line, duplicate, account-name conflict or omitted CRM line has a separate saved decision above. Approved new-line creation is available only to management.</p>
    <label class="vc-check"><input type="checkbox" name="confirm_updates" value="yes" required>
      <strong>I confirm that account <%= account.account_number %> is correct. Apply the safe existing-line updates and archive this original report.</strong>
    </label>
    <div class="vc-actions">
      <button type="submit" class="btn primary" <%= (!preview.accountMatches||preview.baselineChanged||preview.versionChanged||!preview.review.ready)?'disabled':'' %>>Confirm & Update CRM</button>
      <a class="btn" href="<%= basePath %>/customers/<%= client.id %>/viralco-sync">Cancel</a>
    </div>
  </form>
  <p class="vc-hint">Updates to existing CRM lines: Package, Previous Upgrade/Activation Date, and Next Upgrade/Eligibility Date. All other ViralCo fields are saved as a linked source record, including SIM, term date, subscriber, invoice name, Upgradable Y/N, average spend and status code. Invoice amounts, tasks, notes, birthdays and staff ownership are not overwritten.</p>
</section>
<% } %>
<section class="panel vc-panel">
  <h2>Current ViralCo details</h2>
  <% if(!current){ %><div class="empty-state">No original ViralCo Subscriber Detailed Report has been confirmed for this account.</div><% } else { %>
  <p><%= current.line_count %> subscriber lines · <%= current.updated_count %> existing clients updated · <%= current.created_count %> created with manager approval · <%= current.review_count %> to review.</p>
  <div class="vc-table-scroll">
    <table class="data-table vc-table">
      <thead><tr><th>Mobile</th><th>Subscriber</th><th>Package</th><th>Eligibility date</th><th>Upgradable?</th><th>Average spend</th><th>CRM result</th></tr></thead>
      <tbody><% lines.forEach(line=>{ %><tr>
        <td><%= line.msisdn_original %></td><td><%= line.subscriber_name||'—' %></td><td><%= line.pack_desc %></td>
        <td><%= line.earliest_upgrade_date||'—' %></td><td><%= line.upgradable==='Y'?'Yes':'No' %></td>
        <td><%= line.avg_spend===null?'—':'R '+Number(line.avg_spend).toFixed(2) %></td>
        <td><%= line.sync_action.replace('_',' ') %><% if(line.matched_client_id){ %> — <a href="<%= basePath %>/customers/<%= line.matched_client_id %>/360">CRM line</a><% } %></td>
      </tr><% }) %></tbody>
    </table>
  </div>
  <% if(pageCount>1){ %><nav class="vc-pagination"><% if(page>1){ %><a class="btn" href="<%= basePath %>/customers/<%= client.id %>/viralco-sync?page=<%= page-1 %>">Previous</a><% } %>
    <span>Page <%= page %> of <%= pageCount %></span>
    <% if(page<pageCount){ %><a class="btn" href="<%= basePath %>/customers/<%= client.id %>/viralco-sync?page=<%= page+1 %>">Next</a><% } %>
  </nav><% } %>
  <% } %>
</section>
<section class="panel vc-panel" id="viralco-outstanding">
  <h2>Outstanding ViralCo Issues</h2>
  <p>Held or manager-referred issues remain here after publication. You can add a decision without uploading the entire Excel report again. Closing an issue here does not silently move or cancel a CRM line.</p>
  <% if(typeof outstanding==='undefined'||!outstanding||!outstanding.length){ %><div class="empty-state">No saved outstanding ViralCo issues for this business account.</div><% }else{ %>
    <div class="vc-outstanding-list">
      <% outstanding.forEach(issue=>{ %>
        <article class="vc-outstanding-item">
          <div><strong>Conflict <%= issue.issue_number %> — <%= issue.details?.label||issue.issue_type %></strong>
            <small>MSISDN: <%= issue.phone_normalised?'0'+issue.phone_normalised.slice(2):'Account issue' %>
              <% if(issue.source_row){ %> · Excel row <%= issue.source_row %><% } %> · Version #<%= issue.version_id %></small>
            <p><%= issue.details?.reason||'Follow-up required' %></p>
            <small><%= issue.status.toUpperCase() %> — <%= issue.note||'No notes' %></small>
          </div>
          <form method="post" action="<%= basePath %>/customers/<%= client.id %>/viralco-sync/outstanding/<%= issue.id %>">
            <input type="hidden" name="viralco_csrf" value="<%= csrfToken %>">
            <select name="choice" required aria-label="Resolve Conflict <%= issue.issue_number %>">
              <option value="hold">Keep on hold</option>
              <option value="refer_manager" <%= issue.status==='referred'?'selected':'' %>>Refer to manager</option>
              <option value="keep_crm">Investigated — keep CRM unchanged / close</option>
            </select>
            <textarea rows="2" maxlength="900" name="note" required placeholder="Investigation outcome"></textarea>
            <button type="submit" class="btn">Save Follow-up</button>
          </form>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
<section class="panel vc-panel">
  <h2>Import history</h2>
  <p>Every original report is archived by account and staff member. To revisit an earlier version, download that report and run a new reviewed upload. No automatic rollback can silently overwrite subsequent CRM changes.</p>
  <% if(!versions.length){ %><div class="empty-state">The history starts after the first confirmed upload.</div><% } else { %>
  <div class="vc-history">
    <% versions.forEach(v=>{ %><div class="vc-history-item">
      <div><strong>Version <%= v.version_no %> <%= v.is_current?'— Current':'' %></strong><small><%= v.filename %> · <%= v.provider_company_name %> · <%= new Date(v.published_at).toLocaleString('en-ZA') %></small>
        <small><%= v.line_count %> rows · <%= v.review_count %> pending review</small></div>
      <a class="btn" href="<%= basePath %>/customers/<%= client.id %>/viralco-sync/download/<%= v.id %>">Download Original</a>
    </div><% }) %>
  </div><% } %>
</section>
<p class="vc-footnote">UAT test environment. Each employee may update only assigned accounts; owner/manager can resolve company name and new-line decisions. Other live systems are unaffected.</p>
