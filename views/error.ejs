<div class="panel">
  <h1><%= title %></h1>
  <p><%= message %></p>
  <% if (typeof isLive !== 'undefined' && !isLive && typeof diagnostic !== 'undefined' && diagnostic) { %>
    <div class="warning-box" style="margin:14px 0"><strong>Diagnostic details:</strong> <%= diagnostic %></div>
  <% } %>
  <a class="btn" href="<%= basePath %>/workspace">My Day</a>
</div>
