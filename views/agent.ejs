<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#fff8ef">
  <title>Gerda Agent · Talk2Me</title>
  <link rel="manifest" href="<%= basePath %>/agent/manifest.webmanifest">
  <style>
    :root{--ink:#33263b;--muted:#756b79;--paper:#fffaf3;--card:#fff;--line:#eadfd7;--berry:#9d3f74;--berry-dark:#713052;--coral:#ee765d;--gold:#e7a936;--mint:#dff2df;--green:#24734f;--soft:#f7efe9;--lav:#f4eafa;--shadow:0 14px 40px rgba(78,46,62,.10)}
    *{box-sizing:border-box}html,body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}body{min-height:100vh;background:radial-gradient(circle at 8% 0%,rgba(238,118,93,.12),transparent 25%),radial-gradient(circle at 93% 5%,rgba(231,169,54,.13),transparent 23%),linear-gradient(180deg,#fffaf3 0,#fffdf9 55%,#fbf4ed 100%)}button,input{font:inherit}.app{width:min(100%,1180px);margin:0 auto;padding:18px 18px 46px}.top{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:4px 2px 16px}.brand{display:flex;align-items:center;gap:11px}.mark{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;background:var(--ink);color:#fff;font-weight:1000;letter-spacing:-.08em;box-shadow:0 8px 20px rgba(51,38,59,.16)}.brand strong{display:block;font-size:1rem}.brand span{font-size:.7rem;color:var(--berry);text-transform:uppercase;letter-spacing:.13em;font-weight:900}.user{display:flex;align-items:center;gap:10px;color:var(--muted);font-size:.82rem}.logout{border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:12px;padding:9px 12px;font-weight:850;cursor:pointer}.status-row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}.live{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;background:var(--mint);color:var(--green);font-weight:900;font-size:.82rem}.live i{width:8px;height:8px;border-radius:50%;background:#33a36d;box-shadow:0 0 0 5px rgba(51,163,109,.12)}.install{border:1px solid #e4d7ce;background:#fff;color:var(--berry-dark);border-radius:999px;padding:9px 13px;font-weight:850;cursor:pointer}
    .command{border:1px solid var(--line);background:rgba(255,255,255,.93);border-radius:22px;padding:18px;margin-bottom:16px;box-shadow:var(--shadow)}.command label{display:block;font-weight:900;margin-bottom:9px}.command-row{display:grid;grid-template-columns:1fr auto;gap:10px}.command input{width:100%;min-width:0;border:1px solid #dccfc7;background:#fffdfb;color:var(--ink);border-radius:14px;padding:14px 15px;outline:none}.command input:focus{border-color:var(--berry);box-shadow:0 0 0 4px rgba(157,63,116,.10)}.command button{border:0;border-radius:14px;padding:0 23px;background:var(--berry);color:#fff;font-weight:950;cursor:pointer}.quick{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.quick a{text-decoration:none;padding:8px 11px;border-radius:999px;background:var(--soft);border:1px solid #ebddd4;color:var(--ink);font-size:.82rem;font-weight:850}
    .section-title{display:flex;align-items:end;justify-content:space-between;gap:12px;margin:19px 1px 10px}.section-title h2{margin:0;font-size:1.08rem}.section-title span{font-size:.78rem;color:var(--muted)}.staff-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:10px;margin-bottom:16px}.staff-card{border:1px solid var(--line);background:#fff;border-radius:18px;padding:14px;text-align:left;color:var(--ink);cursor:pointer;box-shadow:0 7px 18px rgba(78,46,62,.06);transition:.15s}.staff-card:hover{transform:translateY(-2px);border-color:#d8b9c9}.staff-head{display:flex;align-items:center;justify-content:space-between;gap:8px}.staff-name{font-weight:950}.staff-state{width:10px;height:10px;border-radius:50%;background:#c8bfc4}.staff-state.on{background:#3ba775;box-shadow:0 0 0 5px rgba(59,167,117,.10)}.staff-mini{display:grid;grid-template-columns:repeat(2,1fr);gap:5px;margin-top:11px}.staff-mini span{background:var(--soft);border-radius:10px;padding:7px 8px;font-size:.72rem;color:var(--muted)}.staff-mini b{display:block;color:var(--ink);font-size:.95rem;margin-top:2px}
    .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px;margin-bottom:16px}.metric{border:1px solid var(--line);background:#fff;border-radius:19px;padding:18px;text-align:left;color:var(--ink);cursor:pointer;box-shadow:0 8px 22px rgba(78,46,62,.07);transition:.16s;position:relative;overflow:hidden}.metric:after{content:'›';position:absolute;right:14px;top:12px;color:#b99ead;font-size:1.45rem;font-weight:500}.metric:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(78,46,62,.11);border-color:#d8b9c9}.metric:nth-child(3n+1){border-top:4px solid var(--berry)}.metric:nth-child(3n+2){border-top:4px solid var(--coral)}.metric:nth-child(3n+3){border-top:4px solid var(--gold)}.metric span{display:block;color:var(--muted);font-size:.73rem;text-transform:uppercase;letter-spacing:.065em;font-weight:900;padding-right:20px}.metric strong{display:block;font-size:2rem;margin-top:7px;letter-spacing:-.04em}.metric small{display:block;color:var(--berry);font-weight:850;margin-top:6px}.metric.off{opacity:.5;cursor:default}
    .lower{display:grid;grid-template-columns:1fr 1fr;gap:12px}.section{border:1px solid var(--line);background:rgba(255,255,255,.92);border-radius:20px;padding:18px;overflow:hidden;box-shadow:0 8px 22px rgba(78,46,62,.05)}.section h2{margin:0 0 4px;font-size:1.05rem}.section>p{margin:0 0 13px;color:var(--muted);font-size:.86rem}.activity-list{display:grid;gap:8px}.activity-item{padding:10px 11px;border-radius:13px;background:var(--soft);font-size:.82rem}.activity-item b{display:block;margin-bottom:2px}.activity-item span{color:var(--muted)}.usage-list{display:grid;gap:8px}.usage-row{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 11px;border-radius:13px;background:#faf4fb}.usage-row span{font-size:.82rem}.usage-row b{color:var(--berry)}.empty{padding:14px;border-radius:13px;background:var(--soft);color:var(--muted);font-size:.84rem}
    dialog{width:min(94vw,860px);max-height:88vh;border:0;border-radius:24px;padding:0;background:#fffdf9;color:var(--ink);box-shadow:0 30px 90px rgba(67,39,55,.30)}dialog::backdrop{background:rgba(54,38,49,.45);backdrop-filter:blur(3px)}.drawer-head{position:sticky;top:0;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 20px;border-bottom:1px solid var(--line);background:rgba(255,253,249,.97)}.drawer-head h2{margin:0;font-size:1.2rem}.close{width:36px;height:36px;border:0;border-radius:50%;background:var(--soft);color:var(--ink);font-size:1.25rem;cursor:pointer}.drawer-body{padding:18px 20px 22px}.detail-summary{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 14px}.pill{padding:7px 10px;border-radius:999px;background:var(--lav);color:var(--berry-dark);font-size:.78rem;font-weight:850}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:650px}.table th,.table td{text-align:left;padding:10px 9px;border-bottom:1px solid #eee4dd;font-size:.84rem;vertical-align:top}.table th{font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}.table td strong{font-weight:900}.staff-work{display:grid;gap:9px}.work-row{padding:11px 12px;border:1px solid #eee2d9;border-radius:14px;background:#fff}.work-row small{display:block;color:var(--berry);font-weight:900;text-transform:uppercase;letter-spacing:.05em}.work-row b{display:block;margin:4px 0}.work-row time{font-size:.76rem;color:var(--muted)}
    @media(max-width:760px){.app{padding:12px 12px 34px}.top{padding-bottom:12px}.brand span{display:none}.user .name{display:none}.status-row{margin-bottom:11px}.command{padding:15px}.command-row{grid-template-columns:1fr}.command button{padding:13px 18px}.staff-strip{display:flex;overflow:auto;padding-bottom:3px;scroll-snap-type:x proximity}.staff-card{min-width:172px;scroll-snap-align:start}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.metric{padding:15px}.metric strong{font-size:1.7rem}.lower{grid-template-columns:1fr}.section{padding:15px}.section-title{margin-top:16px}.install{display:inline-flex}dialog{width:96vw;max-height:90vh;border-radius:20px}.drawer-body{padding:15px}.drawer-head{padding:15px 16px}}
    @media(max-width:390px){.grid{grid-template-columns:1fr 1fr}.metric span{font-size:.67rem}.metric strong{font-size:1.5rem}.metric small{font-size:.72rem}}
  </style>
</head>
<body>
<% function shortDate(v){ if(!v) return '—'; try { return new Date(v).toLocaleString('en-ZA',{dateStyle:'medium',timeStyle:'short'}); } catch(e){ return String(v); } } %>
  <main class="app">
    <header class="top">
      <div class="brand"><div class="mark">T2M</div><div><strong>Talk2Me</strong><span>Private Management Agent</span></div></div>
      <div class="user"><span class="name"><%= currentUser.full_name || currentUser.email %></span><form method="post" action="<%= basePath %>/logout?return=agent"><button class="logout" type="submit">Sign out</button></form></div>
    </header>

    <div class="status-row"><span class="live"><i></i> LIVE · <%= report.range.label %></span><button class="install" id="agent-install" type="button">Add to phone</button></div>

    <form class="command" method="post" action="<%= basePath %>/agent/check">
      <label for="agent-command">What would you like me to check?</label>
      <div class="command-row"><input id="agent-command" name="command" value="<%= commandText || '' %>" placeholder="Check for me, check weekly, check last 7 days" autocomplete="off"><button type="submit">Check now</button></div>
      <div class="quick"><a href="<%= basePath %>/agent?range=today">Today</a><a href="<%= basePath %>/agent?range=this_week">This week</a><a href="<%= basePath %>/agent?range=last_7_days">Last 7 days</a><a href="<%= basePath %>/agent?range=month_to_date">Month to date</a></div>
    </form>

    <div class="section-title"><h2>Current staff</h2><span>Tap a person to see what they have been doing</span></div>
    <section class="staff-strip">
      <% report.staffSummary.forEach(function(s){ %>
        <button class="staff-card" type="button" data-panel="staff-<%= s.id %>">
          <div class="staff-head"><span class="staff-name"><%= s.staff_name %></span><i class="staff-state <%= Number(s.working_now)>0?'on':'' %>"></i></div>
          <div class="staff-mini"><span>Enquiries<b><%= s.inquiries_handled %></b></span><span>Done<b><%= s.tasks_completed %></b></span><span>Open tasks<b><%= s.tasks_outstanding %></b></span><span>CRM actions<b><%= s.audit_actions %></b></span></div>
        </button>
      <% }) %>
    </section>

    <div class="section-title"><h2>Shop at a glance</h2><span>Tap any number for the detail</span></div>
    <section class="grid">
      <% report.metrics.forEach(function(m){ %>
        <button class="metric <%= m.available ? '' : 'off' %>" type="button" <%= m.available ? 'data-panel="metric-'+m.key+'"' : 'disabled' %>><span><%= m.name %></span><strong><%= m.available ? m.value : '—' %></strong><small><%= m.available ? 'View detail' : 'Unavailable' %></small></button>
      <% }) %>
    </section>

    <section class="lower">
      <div class="section"><h2>Latest CRM activity</h2><p>Most recent centrally audited actions.</p><% if(report.recentAudit.length){ %><div class="activity-list"><% report.recentAudit.slice(0,6).forEach(function(row){ %><div class="activity-item"><b><%= row.staff_name || 'System' %> · <%= row.action_type || 'CRM action' %></b><span><%= row.description || '' %></span></div><% }) %></div><% } else { %><div class="empty">No centrally audited actions yet for this period. This will grow as telemetry is expanded.</div><% } %></div>
      <div class="section"><h2>CRM usage</h2><p>Which parts of the CRM are actually being used.</p><% if(report.screenUsage.length){ %><div class="usage-list"><% report.screenUsage.slice(0,7).forEach(function(row){ %><div class="usage-row"><span><%= row.screen_key %></span><b><%= row.uses %></b></div><% }) %></div><% } else { %><div class="empty">Screen-use telemetry has not started collecting enough data yet.</div><% } %></div>
    </section>
  </main>

  <dialog id="agent-detail"><div class="drawer-head"><h2 id="drawer-title">Detail</h2><button class="close" id="drawer-close" type="button">×</button></div><div class="drawer-body" id="drawer-body"></div></dialog>

  <template id="panel-metric-staff_working"><div class="detail-summary"><span class="pill"><%= report.staffSummary.filter(s=>Number(s.working_now)>0).length %> working now</span><span class="pill"><%= report.staffSummary.length %> active staff accounts</span></div><div class="table-wrap"><table class="table"><thead><tr><th>Staff</th><th>Status</th><th>First clock-in</th><th>Last activity</th></tr></thead><tbody><% report.staffSummary.forEach(function(s){ %><tr><td><strong><%= s.staff_name %></strong></td><td><%= Number(s.working_now)>0?'Working now':'Not active now' %></td><td><%= shortDate(s.first_clock_in) %></td><td><%= shortDate(s.last_activity) %></td></tr><% }) %></tbody></table></div></template>

  <template id="panel-metric-new_inquiries"><% if(report.details.newInquiries.length){ %><div class="table-wrap"><table class="table"><thead><tr><th>Time</th><th>Customer</th><th>Staff</th><th>Status</th><th>Inquiry</th></tr></thead><tbody><% report.details.newInquiries.forEach(function(r){ %><tr><td><%= shortDate(r.created_at) %></td><td><strong><%= r.client_name || r.cell_number || 'Customer' %></strong></td><td><%= r.staff_name %></td><td><%= r.status %></td><td><%= r.query_text || '—' %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty">No new enquiries in this period.</div><% } %></template>

  <template id="panel-metric-inquiries_completed"><% if(report.details.completedInquiries.length){ %><div class="table-wrap"><table class="table"><thead><tr><th>Completed</th><th>Customer</th><th>Staff</th><th>Status</th><th>Inquiry</th></tr></thead><tbody><% report.details.completedInquiries.forEach(function(r){ %><tr><td><%= shortDate(r.completed_at) %></td><td><strong><%= r.client_name || r.cell_number || 'Customer' %></strong></td><td><%= r.staff_name %></td><td><%= r.status %></td><td><%= r.query_text || '—' %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty">No completed enquiries in this period.</div><% } %></template>

  <% function taskTable(rows){ %><% if(rows.length){ %><div class="table-wrap"><table class="table"><thead><tr><th>Task</th><th>Staff</th><th>Status</th><th>Priority</th><th>Due</th></tr></thead><tbody><% rows.forEach(function(r){ %><tr><td><strong><%= r.title || 'Task' %></strong></td><td><%= r.staff_name %></td><td><%= r.status %></td><td><%= r.priority %></td><td><%= shortDate(r.due_at) %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty">Nothing to show for this period.</div><% } %><% } %>
  <template id="panel-metric-tasks_created"><% taskTable(report.details.createdTasks) %></template>
  <template id="panel-metric-tasks_completed"><% taskTable(report.details.completedTasks) %></template>
  <template id="panel-metric-outstanding_tasks"><% taskTable(report.details.outstandingTasks) %></template>
  <template id="panel-metric-overdue_tasks"><% taskTable(report.details.overdueTasks) %></template>

  <template id="panel-metric-new_customers"><% if(report.details.newCustomers.length){ %><div class="table-wrap"><table class="table"><thead><tr><th>Created</th><th>Customer</th><th>Cell</th><th>Account</th><th>Type</th></tr></thead><tbody><% report.details.newCustomers.forEach(function(r){ %><tr><td><%= shortDate(r.created_at) %></td><td><strong><%= r.client_name || 'Customer' %></strong></td><td><%= r.cell_number || '—' %></td><td><%= r.account_number || '—' %></td><td><%= r.customer_type || '—' %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty">No new customers or prospects in this period.</div><% } %></template>

  <template id="panel-metric-audited_actions"><% if(report.recentAudit.length){ %><div class="table-wrap"><table class="table"><thead><tr><th>Time</th><th>Staff</th><th>Action</th><th>Details</th></tr></thead><tbody><% report.recentAudit.forEach(function(r){ %><tr><td><%= shortDate(r.created_at) %></td><td><strong><%= r.staff_name || 'System' %></strong></td><td><%= r.action_type || '—' %></td><td><%= r.description || '—' %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty">No centrally audited actions in this period.</div><% } %></template>

  <% report.staffSummary.forEach(function(s){ var work=report.staffRecentWork.filter(function(w){return Number(w.staff_id)===Number(s.id)}).slice(0,30); %>
    <template id="panel-staff-<%= s.id %>"><div class="detail-summary"><span class="pill"><%= Number(s.working_now)>0?'Working now':'Not active now' %></span><span class="pill"><%= s.inquiries_handled %> enquiries</span><span class="pill"><%= s.tasks_completed %> tasks completed</span><span class="pill"><%= s.tasks_outstanding %> open tasks</span></div><% if(work.length){ %><div class="staff-work"><% work.forEach(function(w){ %><div class="work-row"><small><%= w.kind %></small><b><%= w.summary %></b><time><%= shortDate(w.occurred_at) %></time></div><% }) %></div><% } else { %><div class="empty">No recorded work activity was found for <%= s.staff_name %> in this period.</div><% } %></template>
  <% }) %>

  <script>
    (()=>{
      let deferred=null;const install=document.getElementById('agent-install');
      window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();deferred=e});
      install?.addEventListener('click',async()=>{if(deferred){deferred.prompt();await deferred.userChoice;deferred=null;return}alert('On iPhone use Share → Add to Home Screen. On Android use the browser menu → Add to Home screen / Install app.')});
      const dialog=document.getElementById('agent-detail'),body=document.getElementById('drawer-body'),title=document.getElementById('drawer-title');
      const titles={staff_working:'Staff working now',new_inquiries:'New enquiries',inquiries_completed:'Completed enquiries',tasks_created:'Tasks created',tasks_completed:'Tasks completed',new_customers:'New customers / prospects',outstanding_tasks:'Outstanding tasks',overdue_tasks:'Overdue tasks',audited_actions:'Audited CRM actions'};
      document.querySelectorAll('[data-panel]').forEach(btn=>btn.addEventListener('click',()=>{const key=btn.dataset.panel,template=document.getElementById('panel-'+key);if(!template)return;body.innerHTML='';body.appendChild(template.content.cloneNode(true));title.textContent=key.startsWith('staff-')?btn.querySelector('.staff-name')?.textContent||'Staff activity':titles[key.replace('metric-','')]||'Detail';dialog.showModal()}));
      document.getElementById('drawer-close')?.addEventListener('click',()=>dialog.close());
      dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});
    })();
  </script>
</body>
</html>
