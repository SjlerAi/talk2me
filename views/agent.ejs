<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#f97316">
  <title>Gerda Agent · Talk2Me</title>
  <link rel="manifest" href="<%= basePath %>/agent/manifest.webmanifest">
  <style>
    :root{--ink:#2f2a25;--muted:#756c64;--paper:#fbf8f3;--card:#fffdf9;--line:#eadfd4;--orange:#f97316;--orange2:#ffedd5;--coral:#fb7185;--green:#22c55e;--mint:#dcfce7;--plum:#7c3aed;--lav:#ede9fe;--gold:#f59e0b;--shadow:0 16px 42px rgba(91,64,39,.10)}
    *{box-sizing:border-box}html,body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}body{min-height:100vh;background:radial-gradient(circle at 0 0,rgba(249,115,22,.08),transparent 26%),radial-gradient(circle at 100% 0,rgba(124,58,237,.06),transparent 24%),var(--paper)}a{color:inherit}.app{width:min(100%,1180px);margin:0 auto;padding:18px 18px 42px}.top{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:6px 2px 18px}.brand{display:flex;align-items:center;gap:11px}.mark{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;background:#fff;color:var(--orange);font-weight:1000;box-shadow:var(--shadow)}.brand strong{display:block;font-size:1.02rem}.brand span{font-size:.71rem;color:var(--orange);text-transform:uppercase;letter-spacing:.13em;font-weight:900}.user{display:flex;align-items:center;gap:12px;color:var(--muted);font-size:.82rem}.logout{border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:12px;padding:9px 12px;font-weight:800;cursor:pointer}.statusbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}.live{display:inline-flex;align-items:center;gap:7px;padding:8px 11px;border-radius:999px;background:var(--mint);color:#166534;font-weight:900;font-size:.84rem}.live i{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 0 5px rgba(34,197,94,.10)}.install{border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:999px;padding:8px 11px;font-weight:800;cursor:pointer}
    .command,.staff-strip,.section{background:rgba(255,253,249,.94);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow)}.command{padding:18px;margin-bottom:14px}.command label{display:block;font-weight:900;margin-bottom:9px}.command-row{display:grid;grid-template-columns:1fr auto;gap:10px}.command input{width:100%;min-width:0;border:1px solid #dccfc2;background:#fff;color:var(--ink);border-radius:14px;padding:14px 15px;font:inherit;outline:none}.command input:focus{border-color:var(--orange);box-shadow:0 0 0 4px rgba(249,115,22,.10)}.command button{border:0;border-radius:14px;padding:0 22px;background:var(--orange);color:#fff;font-weight:1000;cursor:pointer}.quick{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.quick a{text-decoration:none;padding:8px 11px;border-radius:999px;background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;font-size:.83rem;font-weight:800}
    .staff-strip{padding:16px 16px 14px;margin-bottom:14px}.strip-head{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:10px}.strip-head h2{margin:0;font-size:1.05rem}.strip-head span{color:var(--muted);font-size:.82rem}.staff-chips{display:flex;gap:9px;overflow:auto;padding-bottom:2px}.staff-chip{flex:0 0 auto;min-width:128px;text-decoration:none;border:1px solid var(--line);background:#fff;border-radius:16px;padding:11px 12px;transition:.16s}.staff-chip:hover{transform:translateY(-1px);box-shadow:0 9px 24px rgba(91,64,39,.10)}.staff-chip.active{border-color:#fdba74;background:#fff7ed}.staff-name{display:flex;align-items:center;gap:7px;font-weight:900}.dot{width:9px;height:9px;border-radius:50%;background:#d1d5db}.dot.on{background:var(--green)}.staff-meta{display:block;margin-top:5px;color:var(--muted);font-size:.74rem}
    .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:14px}.metric{display:block;text-decoration:none;border:1px solid var(--line);background:var(--card);border-radius:19px;padding:18px;transition:.16s;box-shadow:0 8px 24px rgba(91,64,39,.05)}.metric:hover{transform:translateY(-2px);box-shadow:var(--shadow);border-color:#fdba74}.metric.active{background:#fff7ed;border-color:#fdba74}.metric span{display:block;color:var(--muted);font-size:.74rem;text-transform:uppercase;letter-spacing:.07em;font-weight:900}.metric strong{display:block;font-size:2rem;margin-top:7px;letter-spacing:-.04em}.metric em{display:block;margin-top:7px;color:#c2410c;font-size:.75rem;font-style:normal;font-weight:800}.metric.off{opacity:.45;pointer-events:none}
    .section{padding:20px;margin-bottom:14px;overflow:hidden}.section h2{margin:0 0 4px;font-size:1.25rem}.section>p{margin:0 0 15px;color:var(--muted)}.detail-head{display:flex;justify-content:space-between;gap:12px;align-items:start}.close{flex:0 0 auto;text-decoration:none;border:1px solid var(--line);background:#fff;border-radius:999px;padding:7px 10px;font-size:.78rem;font-weight:800}.detail-list{display:grid;gap:9px}.detail-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;padding:12px 13px;border:1px solid var(--line);background:#fff;border-radius:14px}.detail-row strong{display:block}.detail-row small{display:block;color:var(--muted);margin-top:3px}.detail-row time{color:var(--muted);font-size:.78rem;white-space:nowrap}.staff-overview{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin:14px 0}.mini{background:#fff7ed;border:1px solid #fed7aa;border-radius:14px;padding:12px}.mini span{display:block;color:#9a3412;font-size:.7rem;text-transform:uppercase;font-weight:900}.mini strong{display:block;font-size:1.3rem;margin-top:4px}.subgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.subpanel{border:1px solid var(--line);border-radius:16px;padding:14px;background:#fff}.subpanel h3{margin:0 0 10px;font-size:.98rem}.item{padding:9px 0;border-bottom:1px solid #f0e7df}.item:last-child{border-bottom:0}.item strong{display:block}.item small{color:var(--muted)}.empty{padding:16px;border-radius:14px;background:#faf3ec;color:var(--muted)}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:640px}.table th,.table td{text-align:left;padding:11px 10px;border-bottom:1px solid #eee4db;font-size:.88rem}.table th{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}.staff-link{font-weight:900;color:#c2410c;text-decoration:none}.staff-link:hover{text-decoration:underline}.foot{font-size:.77rem;color:#9b8d81;margin-top:10px}.privacy{color:#9b8d81;font-size:.75rem;padding:2px 4px 0}
    @media(max-width:760px){.app{padding:12px 12px 32px}.top{padding-bottom:12px}.brand span{display:none}.user .name{display:none}.statusbar{align-items:flex-start}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.metric{padding:15px}.metric strong{font-size:1.65rem}.command-row{grid-template-columns:1fr}.command button{padding:14px 18px}.section{padding:16px}.staff-overview{grid-template-columns:repeat(2,minmax(0,1fr))}.subgrid{grid-template-columns:1fr}.detail-row{grid-template-columns:1fr}.detail-row time{white-space:normal}.strip-head{display:block}.strip-head span{display:block;margin-top:3px}}
    @media(max-width:390px){.grid{grid-template-columns:1fr 1fr}.metric span{font-size:.67rem}.metric strong{font-size:1.5rem}}
  </style>
</head>
<body>
<% const fmt = value => value ? new Date(value).toLocaleString('en-ZA',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '—'; %>
  <main class="app">
    <header class="top">
      <div class="brand"><div class="mark">T2M</div><div><strong>Talk2Me</strong><span>Private Management Agent</span></div></div>
      <div class="user"><span class="name"><%= currentUser.full_name || currentUser.email %></span><form method="post" action="<%= basePath %>/logout?return=agent"><button class="logout" type="submit">Sign out</button></form></div>
    </header>

    <div class="statusbar"><span class="live"><i></i> LIVE · <%= report.range.label %></span><button class="install" id="agent-install" type="button">Add to phone</button></div>

    <form class="command" method="post" action="<%= basePath %>/agent/check">
      <label for="agent-command">What would you like me to check?</label>
      <div class="command-row"><input id="agent-command" name="command" value="<%= commandText || '' %>" placeholder="Check for me, check weekly, check last 7 days" autocomplete="off"><button type="submit">Check now</button></div>
      <div class="quick"><a href="<%= basePath %>/agent?range=today">Today</a><a href="<%= basePath %>/agent?range=this_week">This week</a><a href="<%= basePath %>/agent?range=last_7_days">Last 7 days</a><a href="<%= basePath %>/agent?range=month_to_date">Month to date</a></div>
    </form>

    <section class="staff-strip">
      <div class="strip-head"><div><h2>Current staff</h2><span>Tap a person to see what they have been doing.</span></div></div>
      <div class="staff-chips">
        <% report.staffSummaries.forEach(function(s){ %>
          <a class="staff-chip <%= report.selectedStaff && Number(report.selectedStaff.staff.id)===Number(s.id)?'active':'' %>" href="<%= basePath %>/agent?range=<%= report.range.key %>&staff=<%= s.id %>#staff-detail">
            <span class="staff-name"><i class="dot <%= Number(s.working_now)?'on':'' %>"></i><%= s.staff_name %></span>
            <span class="staff-meta"><%= Number(s.working_now)?'Working now':'Not clocked in' %> · <%= Number(s.inquiries_created||0) %> inquiries · <%= Number(s.tasks_completed||0) %> tasks done</span>
          </a>
        <% }) %>
      </div>
    </section>

    <section class="grid">
      <% report.metrics.forEach(function(m){ %>
        <a class="metric <%= m.available?'':'off' %> <%= report.metricDetail&&report.metricDetail.key===m.key?'active':'' %>" href="<%= basePath %>/agent?range=<%= report.range.key %>&metric=<%= m.key %>#metric-detail">
          <span><%= m.name %></span><strong><%= m.available?m.value:'—' %></strong><em>View details →</em>
        </a>
      <% }) %>
    </section>

    <% if(report.metricDetail){ %>
      <section class="section" id="metric-detail">
        <div class="detail-head"><div><h2><%= report.metricDetail.title %></h2><p><%= report.range.label %> · click another card to change this view.</p></div><a class="close" href="<%= basePath %>/agent?range=<%= report.range.key %>">Close</a></div>
        <% if(report.metricDetail.rows.length){ %><div class="detail-list"><% report.metricDetail.rows.forEach(function(row){ %><div class="detail-row"><div><strong><%= row.primary_text || 'Item' %></strong><small><%= row.secondary_text || '' %></small></div><time><%= fmt(row.event_time) %></time></div><% }) %></div><% } else { %><div class="empty">Nothing was found for this selection.</div><% } %>
      </section>
    <% } %>

    <% if(report.selectedStaff){ const s=report.selectedStaff.staff; %>
      <section class="section" id="staff-detail">
        <div class="detail-head"><div><h2><%= s.staff_name %></h2><p><%= report.range.label %> activity from the CRM records currently available.</p></div><a class="close" href="<%= basePath %>/agent?range=<%= report.range.key %>">Close</a></div>
        <div class="staff-overview">
          <div class="mini"><span>Inquiries</span><strong><%= report.selectedStaff.inquiries.length %></strong></div>
          <div class="mini"><span>Tasks received / worked</span><strong><%= report.selectedStaff.assignedTasks.length %></strong></div>
          <div class="mini"><span>Tasks created</span><strong><%= report.selectedStaff.createdTasks.length %></strong></div>
          <div class="mini"><span>Audited actions</span><strong><%= report.selectedStaff.audit.length %></strong></div>
        </div>
        <div class="subgrid">
          <div class="subpanel"><h3>Inquiries handled</h3><% if(report.selectedStaff.inquiries.length){ report.selectedStaff.inquiries.forEach(function(x){ %><div class="item"><strong><%= x.client_name %></strong><small><%= x.status %> · <%= fmt(x.created_at) %><%= x.query_text?' · '+String(x.query_text).slice(0,110):'' %></small></div><% }) } else { %><div class="empty">No inquiries recorded for this period.</div><% } %></div>
          <div class="subpanel"><h3>Tasks assigned / completed</h3><% if(report.selectedStaff.assignedTasks.length){ report.selectedStaff.assignedTasks.forEach(function(x){ %><div class="item"><strong><%= x.title %></strong><small><%= x.status %> · <%= x.priority %> · <%= fmt(x.completed_at||x.created_at) %></small></div><% }) } else { %><div class="empty">No assigned task activity recorded for this period.</div><% } %></div>
          <div class="subpanel"><h3>Tasks created</h3><% if(report.selectedStaff.createdTasks.length){ report.selectedStaff.createdTasks.forEach(function(x){ %><div class="item"><strong><%= x.title %></strong><small><%= x.status %> · <%= fmt(x.created_at) %></small></div><% }) } else { %><div class="empty">No tasks created in this period.</div><% } %></div>
          <div class="subpanel"><h3>Other audited activity</h3><% if(report.selectedStaff.audit.length){ report.selectedStaff.audit.forEach(function(x){ %><div class="item"><strong><%= x.action_type %></strong><small><%= fmt(x.created_at) %><%= x.description?' · '+x.description:'' %></small></div><% }) } else { %><div class="empty">No centrally audited actions recorded for this period.</div><% } %></div>
        </div>
      </section>
    <% } %>

    <section class="section"><h2>Who has been working</h2><p>Attendance evidence for <%= report.range.label.toLowerCase() %>. Staff names are clickable.</p><% if(report.staffActivity.length){ %><div class="table-wrap"><table class="table"><thead><tr><th>Staff</th><th>First clock-in</th><th>Last activity</th><th>Working now</th></tr></thead><tbody><% report.staffActivity.forEach(function(row){ %><tr><td><a class="staff-link" href="<%= basePath %>/agent?range=<%= report.range.key %>&staff=<%= row.id %>#staff-detail"><%= row.staff_name %></a></td><td><%= fmt(row.first_clock_in) %></td><td><%= fmt(row.last_activity) %></td><td><%= Number(row.active_sessions||0)>0?'Yes':'No' %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty">No attendance activity was found for this period.</div><% } %></section>

    <section class="section"><h2>Recent CRM activity</h2><p>Most recent centrally audited actions for the selected period.</p><% if(report.recentAudit.length){ %><div class="table-wrap"><table class="table"><thead><tr><th>Time</th><th>Staff</th><th>Action</th><th>Details</th></tr></thead><tbody><% report.recentAudit.forEach(function(row){ %><tr><td><%= fmt(row.created_at) %></td><td><%= row.staff_name || 'System' %></td><td><%= row.action_type || '—' %></td><td><%= row.description || '' %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty">No centrally audited actions were found for this period. Additional CRM telemetry will expand this section.</div><% } %></section>

    <section class="section"><h2>CRM usage</h2><p>Usage intelligence becomes richer as the telemetry layer collects activity.</p><% if(report.screenUsage.length){ %><div class="table-wrap"><table class="table"><thead><tr><th>Screen</th><th>Uses</th><th>Staff</th><th>Last used</th></tr></thead><tbody><% report.screenUsage.forEach(function(row){ %><tr><td><strong><%= row.screen_key %></strong></td><td><%= row.uses %></td><td><%= row.staff_count %></td><td><%= fmt(row.last_used_at) %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty">No screen telemetry has been collected yet.</div><% } %><div class="foot">Generated <%= fmt(report.generatedAt) %>.</div></section>

    <div class="privacy">Read/report focused · no destructive database controls exposed.</div>
  </main>
  <script>
    (()=>{let deferred=null;const button=document.getElementById('agent-install');window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();deferred=e});button?.addEventListener('click',async()=>{if(deferred){deferred.prompt();await deferred.userChoice;deferred=null;return}alert('On iPhone use Share → Add to Home Screen. On Android use the browser menu → Add to Home screen / Install app.')})})();
  </script>
</body>
</html>
