APP_NAME=Talk2Me CRM
APP_URL=https://uent.co.za/talk2me
BASE_PATH=/talk2me
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=uent_talk2me_crm
DB_USER=uent_uent_talk2me_user
DB_PASSWORD=PUT_DATABASE_PASSWORD_HERE

SESSION_SECRET=change_this_to_a_long_random_secret

# Approved Talk2Me outbound communication
# Primary can fall back to the legacy SMTP_* values for compatibility.
ALLOW_MANAGEMENT_EXTERNAL_NOTIFICATIONS=false
CUDO_EXTERNAL_SEND_ENABLED=false

TALK2ME_EMAIL_PRIMARY_HOST=
TALK2ME_EMAIL_PRIMARY_PORT=465
TALK2ME_EMAIL_PRIMARY_SECURE=true
TALK2ME_EMAIL_PRIMARY_USER=
TALK2ME_EMAIL_PRIMARY_PASSWORD=
TALK2ME_EMAIL_PRIMARY_ADDRESS=gerda@talk-online.co.za
TALK2ME_EMAIL_PRIMARY_FROM_NAME=Gerda

TALK2ME_EMAIL_SECONDARY_HOST=
TALK2ME_EMAIL_SECONDARY_PORT=465
TALK2ME_EMAIL_SECONDARY_SECURE=true
TALK2ME_EMAIL_SECONDARY_USER=
TALK2ME_EMAIL_SECONDARY_PASSWORD=
TALK2ME_EMAIL_SECONDARY_ADDRESS=
TALK2ME_EMAIL_SECONDARY_FROM_NAME=Talk2Me CRM

# Meta WhatsApp Business Cloud API
WHATSAPP_PROVIDER=meta
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SENDER_NUMBER=+27829222877
WHATSAPP_API_TOKEN=
